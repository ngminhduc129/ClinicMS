<UserControl x:Class="ClinicMS.Views.ConfirmDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ClinicMS.Views"
             Width="440">
    
    <Border Background="White" CornerRadius="16" BorderBrush="#F3F4F6" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="0" Opacity="0.15" Color="#000"/>
        </Border.Effect>
        
        <StackPanel Margin="32,24">
            <!-- Icon Question -->
            <Border Width="56" Height="56" CornerRadius="28" Background="#EFF6FF" Margin="0,0,0,20">
                <TextBlock Text="&#xE9CE;" FontFamily="Segoe MDL2 Assets" FontSize="24" 
                           Foreground="#3B82F6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            
            <!-- Title -->
            <TextBlock x:Name="TitleTb" FontSize="18" FontWeight="Bold" Foreground="#111827" 
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" 
                       Margin="0,0,0,12" LineHeight="24"/>
            
            <!-- Message -->
            <TextBlock x:Name="MessageTb" FontSize="14" Foreground="#6B7280" 
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" 
                       LineHeight="20" Margin="0,0,0,28"/>
            
            <!-- Action Buttons -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="0" Content="Hủy bỏ" Click="No_Click" Height="42" Cursor="Hand" Style="{StaticResource OutlineBtn}"/>
                
                <Button Grid.Column="2" x:Name="ConfirmBtn" Click="Yes_Click" Height="42" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="#16A34A" CornerRadius="10">
                                <TextBlock x:Name="Txt" Text="Xác nhận" Foreground="White" FontWeight="SemiBold" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#15803D"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsDeleteAction, RelativeSource={RelativeSource AncestorType=local:ConfirmDialog}}" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#EF4444"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
