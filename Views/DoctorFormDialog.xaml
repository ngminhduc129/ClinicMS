<UserControl x:Class="ClinicMS.Views.DoctorFormDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="720"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Ideal">

    <UserControl.Resources>

        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrushSecondary}"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>

        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextBrushPrimary}"/>
            <Setter Property="Background"      Value="{DynamicResource SurfaceBrushWhite}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrushLight}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding"         Value="12,10"/>
            <Setter Property="Height"          Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="FocusShadow" CornerRadius="10" Background="Transparent" Opacity="0">
                                <Border.Effect><StaticResource ResourceKey="FocusShadow"/></Border.Effect>
                            </Border>

                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Padding="{TemplateBinding Padding}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#86EFAC"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource PrimaryGreenBrush}"/>
                                <Setter TargetName="Root" Property="Background"  Value="{DynamicResource PrimaryGreenVeryLightBrush}"/>
                                <Setter TargetName="FocusShadow" Property="Background" Value="{DynamicResource PrimaryGreenVeryLightBrush}"/>
                                <Setter TargetName="FocusShadow" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Overlay" Background="#01000000" MouseLeftButtonDown="Overlay_Click">

        <Grid Width="720" HorizontalAlignment="Center" VerticalAlignment="Center">

            <Border CornerRadius="20" Background="#FAFAFA">
                <Border.Effect><StaticResource ResourceKey="ElevatedShadow"/></Border.Effect>
            </Border>

            <Border x:Name="DialogRoot" CornerRadius="20" ClipToBounds="True" Background="#FAFAFA">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" CornerRadius="20,20,0,0" Padding="26,18">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#15803D" Offset="0"/>
                                <GradientStop Color="#16A34A" Offset="0.5"/>
                                <GradientStop Color="#22C55E" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Ellipse Width="120" Height="120"
                                     HorizontalAlignment="Right" VerticalAlignment="Top"
                                     Margin="0,-40,-30,0" Opacity="0.08" Fill="White"/>
                            <Ellipse Width="70" Height="70"
                                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                     Margin="0,0,60,-20" Opacity="0.06" Fill="White"/>

                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="46" Height="46" CornerRadius="13" Margin="0,0,14,0">
                                        <Border.Background>
                                            <SolidColorBrush Color="White" Opacity="0.15"/>
                                        </Border.Background>
                                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="20" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="TitleText" Text="Thêm Bác Sĩ Mới"
                                                   FontSize="17" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock x:Name="SubtitleText" Text="Điền thông tin bác sĩ cho hệ thống"
                                                   FontSize="12" Foreground="#BBF7D0" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Width="32" Height="32" Cursor="Hand" Click="Close_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" CornerRadius="9" Background="#26FFFFFF">
                                                <TextBlock Text="✕" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="#ECFDF5"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#3AFFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#55FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" Background="#EDEEF0" VerticalScrollBarVisibility="Auto">
                        <Grid Margin="20,18,20,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.6*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Border Background="#FFFFFF" CornerRadius="16">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="18" ShadowDepth="2"/>
                                    </Border.Effect>
                                </Border>

                                <Border Background="#FFFFFF" CornerRadius="16" Padding="20"
                                        BorderBrush="#E5E7EB" BorderThickness="1">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <Border Width="4" Height="18" CornerRadius="3" Margin="0,0,10,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#16A34A" Offset="0"/>
                                                        <GradientStop Color="#22C55E" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <TextBlock Text="THÔNG TIN BÁC SĨ" FontSize="11" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextBrushSecondary}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.3*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Style="{StaticResource FormLabel}">
                                                    Họ và Tên<Run Text=" *" Foreground="{DynamicResource ErrorBrush}"/>
                                                </TextBlock>
                                                <TextBox x:Name="NameBox" Style="{StaticResource FormTextBox}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Chuyên Khoa" Style="{StaticResource FormLabel}"/>
                                                <TextBox x:Name="SpecialtyBox" Style="{StaticResource FormTextBox}"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="1.4*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Số Điện Thoại" Style="{StaticResource FormLabel}"/>
                                                <TextBox x:Name="PhoneBox" Style="{StaticResource FormTextBox}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Email" Style="{StaticResource FormLabel}"/>
                                                <TextBox x:Name="EmailBox" Style="{StaticResource FormTextBox}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Grid.Column="2">
                                <Border Background="#FFFFFF" CornerRadius="16">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#16A34A" Opacity="0.06" BlurRadius="18" ShadowDepth="2"/>
                                    </Border.Effect>
                                </Border>

                                <Border Background="#FFFFFF" CornerRadius="16" Padding="20"
                                        BorderBrush="#E5E7EB" BorderThickness="1">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                            <Border Width="4" Height="18" CornerRadius="3" Margin="0,0,10,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#0EA5E9" Offset="0"/>
                                                        <GradientStop Color="#6366F1" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <TextBlock Text="GHI CHÚ" FontSize="11" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextBrushSecondary}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <TextBox x:Name="NoteBox" Style="{StaticResource FormTextBox}"
                                                 Height="160" TextWrapping="Wrap" AcceptsReturn="True"
                                                 VerticalContentAlignment="Top" Padding="12,10"
                                                 VerticalScrollBarVisibility="Auto"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                        </Grid>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="#FAFAFA"
                            BorderBrush="#E5E7EB" BorderThickness="0,1.5,0,0"
                            CornerRadius="0,0,20,20" Padding="26,14">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource ErrorBrush}"
                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Trường bắt buộc" FontSize="12"
                                           Foreground="{DynamicResource TextBrushTertiary}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button Width="90" Height="38" Margin="0,0,10,0" Cursor="Hand" Click="Cancel_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" CornerRadius="10" Background="#FFFFFF"
                                                    BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1.5">
                                                <TextBlock Text="Hủy" FontSize="13" FontWeight="Medium"
                                                           Foreground="{DynamicResource TextBrushSecondary}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BackgroundBrushLight}"/>
                                                    <Setter TargetName="Bg" Property="BorderBrush" Value="#D1D5DB"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BackgroundBrushDark}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button x:Name="SaveBtn" Height="38" Padding="22,0" Cursor="Hand" Click="Save_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid x:Name="RootGrid">
                                                <Border CornerRadius="10">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#16A34A" Offset="0"/>
                                                            <GradientStop Color="#22C55E" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#16A34A" Opacity="0.38" BlurRadius="14" ShadowDepth="2"/>
                                                    </Border.Effect>
                                                </Border>

                                                <Border CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#16A34A" Offset="0"/>
                                                            <GradientStop Color="#22C55E" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="13" Foreground="White"
                                                                   VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                        <TextBlock x:Name="SaveLabel" Text="Lưu Bác Sĩ"
                                                                   FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="White" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RootGrid" Property="Opacity" Value="0.88"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="RootGrid" Property="Opacity" Value="0.72"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>