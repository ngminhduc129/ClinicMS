<UserControl x:Class="ClinicMS.Views.AppointmentFormDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="520"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Ideal">

    <UserControl.Resources>
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrushSecondary}"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>

        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextBrushPrimary}"/>
            <Setter Property="Background"      Value="{DynamicResource SurfaceBrushWhite}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrushLight}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding"         Value="12,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="FocusShadow" CornerRadius="10" Background="Transparent" Opacity="0">
                                <Border.Effect><StaticResource ResourceKey="FocusShadow"/></Border.Effect>
                            </Border>
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Padding="{TemplateBinding Padding}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#86EFAC"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource PrimaryGreenBrush}"/>
                                <Setter TargetName="Root" Property="Background"  Value="{DynamicResource PrimaryGreenVeryLightBrush}"/>
                                <Setter TargetName="FocusShadow" Property="Background" Value="{DynamicResource PrimaryGreenVeryLightBrush}"/>
                                <Setter TargetName="FocusShadow" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormComboBox" TargetType="ComboBox">
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextBrushPrimary}"/>
            <Setter Property="Background"      Value="{DynamicResource SurfaceBrushWhite}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrushLight}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Height"          Value="40"/>
            <Setter Property="Padding"         Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Root" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="PART_DropDownToggle" Grid.ColumnSpan="2"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False" ClickMode="Press" Background="Transparent" BorderThickness="0">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent">
                                                    <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource TextBrushTertiary}" StrokeThickness="1.5"
                                                          HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <TextBox x:Name="PART_EditableTextBox" Margin="12,0,0,0" Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource TextBrushPrimary}" FontSize="13" VerticalAlignment="Center" Visibility="Hidden"/>
                                    <ContentPresenter x:Name="ContentSite" Content="{TemplateBinding SelectionBoxItem}" Margin="12,0,0,0"
                                                      VerticalAlignment="Center" IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   AllowsTransparency="True"
                                   PopupAnimation="Slide"
                                   VerticalOffset="2">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}" MaxHeight="180"
                                        Background="White" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="12" Margin="0,4,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="2" Opacity="0.1"/>
                                    </Border.Effect>
                                    <ScrollViewer Padding="6"><ItemsPresenter/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource PrimaryGreenBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#86EFAC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrushPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="7" Margin="2,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PrimaryGreenVeryLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PrimaryGreenLightBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryGreenDarkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Overlay" Background="#01000000" MouseLeftButtonDown="Overlay_Click">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="520">
            <Border CornerRadius="20" Background="{DynamicResource SurfaceBrushWhite}">
                <Border.Effect><StaticResource ResourceKey="ElevatedShadow"/></Border.Effect>
            </Border>

            <Border x:Name="DialogRoot" CornerRadius="20" ClipToBounds="True" Background="{DynamicResource SurfaceBrushWhite}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" CornerRadius="20,20,0,0" Padding="26,18" Background="#F0F9F0"
                            BorderBrush="#E5E7EB" BorderThickness="0,0,0,1.5">
                        <Grid>
                            <Border Width="4" Height="28" CornerRadius="2" Background="#16A34A"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Border Width="46" Height="46" CornerRadius="13" Margin="0,0,14,0"
                                        Background="#ECFDF5">
                                    <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="20" Foreground="#16A34A"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TitleText" Text="Thêm Lịch Hẹn Mới"
                                               FontSize="17" FontWeight="Bold" Foreground="#1F2937"/>
                                    <TextBlock x:Name="SubtitleText" Text="Đặt lịch hẹn cho bệnh nhân"
                                               FontSize="12" Foreground="#6B7280" Margin="0,3,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Width="32" Height="32" Cursor="Hand" Click="Close_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" CornerRadius="8" Background="Transparent">
                                            <TextBlock Text="✕" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="#9CA3AF"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="#F3F4F6"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Body -->
                    <Border Grid.Row="1" Background="#EDEEF0" Padding="20">
                        <Border Background="{DynamicResource SurfaceBrushWhite}" CornerRadius="16" Padding="20"
                                BorderBrush="{DynamicResource BackgroundBrushDark}" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Border Width="4" Height="18" CornerRadius="3" Margin="0,0,10,0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#16A34A" Offset="0"/>
                                                <GradientStop Color="#22C55E" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Text="THÔNG TIN LỊCH HẸN" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource TextBrushSecondary}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Style="{StaticResource FormLabel}">Bệnh Nhân<Run Text=" *" Foreground="{DynamicResource ErrorBrush}"/></TextBlock>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" x:Name="PatientCombo" Style="{StaticResource FormComboBox}"
                                                  IsEditable="True" IsTextSearchEnabled="False"
                                                  StaysOpenOnEdit="True" VerticalContentAlignment="Center"/>
                                        <Button x:Name="InlineToggleBtn" Grid.Column="2" Width="36" Height="36"
                                                Click="ToggleInlineAdd_Click"
                                                ToolTip="Thêm nhanh bệnh nhân mới"
                                                Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bg" CornerRadius="8"
                                                            Background="White"
                                                            BorderBrush="#E5E7EB" BorderThickness="1.5">
                                                        <TextBlock x:Name="ToggleIcon" Text="+" FontSize="16" FontWeight="SemiBold"
                                                                   Foreground="#6B7280"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bg" Property="Background" Value="#F9FAFB"/>
                                                            <Setter TargetName="Bg" Property="BorderBrush" Value="#9CA3AF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <!-- Inline Quick Add Container -->
                                <Border x:Name="InlineAddContainer" Visibility="Collapsed"
                                        Margin="0,0,0,14"
                                        CornerRadius="4"
                                        Background="#F8FAFC"
                                        BorderBrush="#E2E8F0" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#16A34A" CornerRadius="1"/>
                                        <Border Grid.Column="1" Padding="12,10">
                                            <StackPanel>
                                                <TextBlock FontSize="10" FontWeight="Bold" Foreground="#16A34A" Margin="0,0,0,8">THÊM NHANH</TextBlock>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="4"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" CornerRadius="4" BorderBrush="#D1D5DB" BorderThickness="1" Height="32"
                                                            Background="White">
                                                        <Grid>
                                                            <TextBox x:Name="InlineNameBox" FontSize="12"
                                                                     Foreground="#111827" Background="Transparent"
                                                                     BorderThickness="0" Padding="8,0"
                                                                     VerticalContentAlignment="Center"/>
                                                            <TextBlock Text="Nhập họ và tên..." FontSize="12" Foreground="#9CA3AF"
                                                                       IsHitTestVisible="False" Padding="8,0" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Text, ElementName=InlineNameBox}" Value="">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>
                                                    <Border Grid.Column="2" CornerRadius="4" BorderBrush="#D1D5DB" BorderThickness="1" Height="32"
                                                            Background="White">
                                                        <Grid>
                                                            <TextBox x:Name="InlinePhoneBox" FontSize="12"
                                                                     Foreground="#111827" Background="Transparent"
                                                                     BorderThickness="0" Padding="8,0"
                                                                     VerticalContentAlignment="Center"/>
                                                            <TextBlock Text="VD: 0912..." FontSize="12" Foreground="#9CA3AF"
                                                                       IsHitTestVisible="False" Padding="8,0" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Text, ElementName=InlinePhoneBox}" Value="">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>
                                                    <Button Grid.Column="4" Height="32" Padding="14,0" Cursor="Hand" Click="InlineSave_Click">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Bg" Background="#16A34A" CornerRadius="4"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <TextBlock Text="Lưu" FontSize="12" FontWeight="SemiBold" Foreground="White"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bg" Property="Background" Value="#15803D"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                    <Button Grid.Column="6" Width="32" Height="32" Cursor="Hand" Click="InlineCancel_Click">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Bg" CornerRadius="4" Background="Transparent">
                                                                    <TextBlock Text="✕" FontSize="12" Foreground="#64748B"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bg" Property="Background" Value="#F1F5F9"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Style="{StaticResource FormLabel}">Bác Sĩ<Run Text=" *" Foreground="{DynamicResource ErrorBrush}"/></TextBlock>
                                    <ComboBox x:Name="DoctorCombo" Style="{StaticResource FormComboBox}"
                                              IsEditable="True" IsTextSearchEnabled="False"
                                              StaysOpenOnEdit="True" VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource FormLabel}">Ngày Hẹn<Run Text=" *" Foreground="{DynamicResource ErrorBrush}"/></TextBlock>
                                        <DatePicker x:Name="ApptDatePicker"
                                                    Height="40" FontSize="13" Foreground="{DynamicResource TextBrushPrimary}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource FormLabel}">Giờ Hẹn<Run Text=" *" Foreground="{DynamicResource ErrorBrush}"/></TextBlock>
                                        <TextBox x:Name="TimeBox" Text="08:00" Style="{StaticResource FormTextBox}" Width="100" Height="40" Padding="12,0"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel>
                                    <TextBlock Style="{StaticResource FormLabel}">Ghi Chú</TextBlock>
                                    <TextBox x:Name="NoteBox" Style="{StaticResource FormTextBox}" Height="40" Padding="12,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Border>

                    <!-- Footer -->
                    <Border Grid.Row="2" Background="{DynamicResource SurfaceBrushWhite}"
                            BorderBrush="{DynamicResource BackgroundBrushDark}" BorderThickness="0,1.5,0,0"
                            CornerRadius="0,0,20,20" Padding="26,14">
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Width="90" Height="38" Margin="0,0,10,0" Cursor="Hand" Click="Cancel_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" CornerRadius="10" Background="{DynamicResource SurfaceBrushWhite}"
                                                BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1.5">
                                            <TextBlock Text="Hủy" FontSize="13" FontWeight="Medium"
                                                       Foreground="{DynamicResource TextBrushSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BackgroundBrushLight}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="SaveBtn" Height="38" Padding="22,0" Cursor="Hand" Click="Save_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid x:Name="RootGrid">
                                            <Border CornerRadius="10">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#16A34A" Offset="0"/>
                                                        <GradientStop Color="#22C55E" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#16A34A" Opacity="0.38" BlurRadius="14" ShadowDepth="2"/>
                                                </Border.Effect>
                                            </Border>
                                            <Border CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#16A34A" Offset="0"/>
                                                        <GradientStop Color="#22C55E" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="13" Foreground="White" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                    <TextBlock x:Name="SaveLabel" Text="Tạo Lịch Hẹn"
                                                               FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="RootGrid" Property="Opacity" Value="0.88"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>