<UserControl x:Class="ClinicMS.Views.PaymentDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>

        <Style x:Key="DialogInputField" TargetType="TextBox">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrushPrimary}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushLight}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bg" Background="White" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource PrimaryGreenBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="White" CornerRadius="20" Width="420" Padding="32">
        <Border.Effect><StaticResource ResourceKey="ElevatedShadow"/></Border.Effect>
        <StackPanel>
            <TextBlock Text="Xác Nhận Thanh Toán" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextBrushPrimary}" Margin="0,0,0,8"/>
            <TextBlock Text="Vui lòng nhập số tiền và phương thức thanh toán." FontSize="14" Foreground="{DynamicResource TextBrushSecondary}" Margin="0,0,0,24"/>

            <Border Background="#F8FAFC" CornerRadius="12" Padding="20,16" Margin="0,0,0,24" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <TextBlock Text="Số tiền còn nợ:" FontSize="13" Foreground="{DynamicResource TextBrushSecondary}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtRemaining" Text="0 ₫" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryGreenBrush}" HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Số tiền khách trả (₫)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrushSecondary}" Margin="0,0,0,8"/>
                <TextBox x:Name="InputAmount" Style="{StaticResource DialogInputField}" Height="50" VerticalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,32">
                <TextBlock Text="Phương thức thanh toán" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrushSecondary}" Margin="0,0,0,8"/>
                <ComboBox x:Name="ComboMethod" Height="40" SelectedIndex="0" VerticalContentAlignment="Center">
                    <ComboBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </ComboBox.Resources>
                    <ComboBoxItem Content="Tiền mặt"/>
                    <ComboBoxItem Content="Chuyển khoản"/>
                    <ComboBoxItem Content="Thẻ ATM/Tín dụng"/>
                </ComboBox>
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button Content="Đóng" Height="44" Cursor="Hand" Click="Cancel_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="Transparent" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1.5" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BackgroundBrushLight}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Grid.Column="2" Content="Xác Nhận" Height="44" Cursor="Hand" Click="Confirm_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{DynamicResource PrimaryGreenBrush}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.Foreground="White" TextBlock.FontWeight="Bold"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Opacity" Value="0.9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
