<UserControl x:Class="ClinicMS.Views.VisitListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Self"
             Background="#F0FDF4"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <!-- Thêm CollectionViewSource để Grouping và Filtering tự động -->
        <CollectionViewSource x:Key="VisitsViewSource" Source="{Binding Visits}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="StatusGroup" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <SolidColorBrush x:Key="C.Green700"  Color="#15803D"/>
        <SolidColorBrush x:Key="C.Green600"  Color="#16A34A"/>
        <SolidColorBrush x:Key="C.Green500"  Color="#22C55E"/>
        <SolidColorBrush x:Key="C.Green100"  Color="#DCFCE7"/>
        <SolidColorBrush x:Key="C.Green50"   Color="#F0FDF4"/>
        <SolidColorBrush x:Key="C.White"     Color="#FFFFFF"/>
        <SolidColorBrush x:Key="C.Gray50"    Color="#F9FAFB"/>
        <SolidColorBrush x:Key="C.Gray100"   Color="#F3F4F6"/>
        <SolidColorBrush x:Key="C.Gray200"   Color="#E5E7EB"/>
        <SolidColorBrush x:Key="C.Gray400"   Color="#9CA3AF"/>
        <SolidColorBrush x:Key="C.Gray600"   Color="#4B5563"/>
        <SolidColorBrush x:Key="C.Gray500"   Color="#6B7280"/>
        <SolidColorBrush x:Key="C.Gray800"   Color="#1F2937"/>
        <SolidColorBrush x:Key="C.Red"       Color="#EF4444"/>

        <!-- ===== FORM LABEL ===== -->
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource C.Gray600}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- ===== SECTION LABEL ===== -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource C.Gray600}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- ===== UNIT LABEL ===== -->
        <Style x:Key="UnitLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{StaticResource C.Gray400}"/>
        </Style>

        <!-- ===== DETAIL CARD ===== -->
        <Style x:Key="DetailCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource C.Gray100}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000" Opacity="0.04" BlurRadius="18" ShadowDepth="3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== INPUT FIELD ===== -->
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Foreground"      Value="{StaticResource C.Gray800}"/>
            <Setter Property="Background"      Value="{StaticResource C.White}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource C.Gray200}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding"         Value="12,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="FocusShadow" CornerRadius="10" Background="Transparent" Opacity="0">
                                <Border.Effect>
                                    <DropShadowEffect Color="#22C55E" Opacity="0.20" BlurRadius="10" ShadowDepth="0"/>
                                </Border.Effect>
                            </Border>

                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Padding="{TemplateBinding Padding}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#86EFAC"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource C.Green600}"/>
                                <Setter TargetName="Root" Property="Background"  Value="{StaticResource C.Green50}"/>
                                <Setter TargetName="FocusShadow" Property="Background" Value="{StaticResource C.Green50}"/>
                                <Setter TargetName="FocusShadow" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== MULTI-LINE INPUT ===== -->
        <Style x:Key="MultiLineField" TargetType="TextBox" BasedOn="{StaticResource InputField}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Height" Value="78"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>

        <!-- ===== STATUS BUTTON ===== -->
        <Style x:Key="StatusBtn" TargetType="Button">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== GREEN BUTTON ===== -->
        <Style x:Key="GreenBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="10" Background="#16A34A">
                            <Border.Effect>
                                <DropShadowEffect Color="#16A34A" BlurRadius="14" ShadowDepth="2" Opacity="0.35" Direction="270"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#15803D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== OUTLINE BUTTON ===== -->
        <Style x:Key="OutlineBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="10" Background="White"
                                BorderBrush="#D1FAE5" BorderThickness="1.5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06" Color="#000"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"  Value="#F0FDF4"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#6EE7B7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== ICON BUTTON ===== -->
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Width"  Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="10" Background="White"
                                BorderBrush="#D1FAE5" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06" Color="#000"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"  Value="#F0FDF4"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#6EE7B7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== DATE PICKER (FILTER) ===== -->
        <Style x:Key="FilterDatePickerTextBox" TargetType="DatePickerTextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePickerTextBox">
                        <Border Background="Transparent" BorderThickness="0">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Padding="0"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterCalendarDayButtonStyle" TargetType="CalendarDayButton">
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarDayButton">
                        <Border x:Name="Root"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Margin="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#ECFDF5"/>
                                <Setter Property="Foreground" Value="#166534"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#16A34A"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#15803D"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsToday" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#22C55E"/>
                            </Trigger>
                            <Trigger Property="IsInactive" Value="True">
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                            </Trigger>
                            <Trigger Property="IsBlackedOut" Value="True">
                                <Setter Property="Foreground" Value="#D1D5DB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterCalendarButtonStyle" TargetType="CalendarButton">
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarButton">
                        <Border x:Name="Root"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                Margin="2"
                                Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#ECFDF5"/>
                                <Setter Property="Foreground" Value="#166534"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#DCFCE7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterCalendarStyle" TargetType="Calendar">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1FAE5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="MinWidth" Value="280"/>
            <Setter Property="MinHeight" Value="250"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="CalendarDayButtonStyle" Value="{StaticResource FilterCalendarDayButtonStyle}"/>
            <Setter Property="CalendarButtonStyle" Value="{StaticResource FilterCalendarButtonStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Calendar">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="10">
                            <CalendarItem x:Name="PART_CalendarItem" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterDatePickerStyle" TargetType="DatePicker">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CalendarStyle" Value="{StaticResource FilterCalendarStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>

                            <DatePickerTextBox x:Name="PART_TextBox"
                                               Style="{StaticResource FilterDatePickerTextBox}"
                                               Margin="0,0,6,0"
                                               VerticalAlignment="Center"/>

                            <Button x:Name="PART_Button"
                                    Grid.Column="1"
                                    Focusable="False"
                                    Width="24"
                                    Height="24"
                                    Margin="0,0,2,0"
                                    Cursor="Hand"
                                    BorderThickness="0"
                                    Background="Transparent">
                                <TextBlock Text="&#xE787;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           Foreground="#9CA3AF"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Button>

                            <Popup x:Name="PART_Popup"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   Focusable="False"
                                   PopupAnimation="Fade"
                                   AllowsTransparency="True">
                                <Border Background="White"
                                        BorderBrush="#D1FAE5"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="8"
                                        Margin="0,6,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.14" Color="#000000"/>
                                    </Border.Effect>
                                    <Calendar x:Name="PART_Calendar"
                                              Style="{TemplateBinding CalendarStyle}"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="PART_Button" Property="Background" Value="#ECFDF5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== SAVE BUTTON ===== -->
        <Style x:Key="SaveBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid">
                            <Border CornerRadius="10">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#16A34A" Offset="0"/>
                                        <GradientStop Color="#22C55E" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#16A34A" Opacity="0.38" BlurRadius="14" ShadowDepth="2"/>
                                </Border.Effect>
                            </Border>

                            <Border CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#16A34A" Offset="0"/>
                                        <GradientStop Color="#22C55E" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootGrid" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== CANCEL BUTTON ===== -->
        <Style x:Key="CancelBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="10" Background="{StaticResource C.White}"
                                BorderBrush="{StaticResource C.Gray200}" BorderThickness="1.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource C.Gray50}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormComboBox" TargetType="ComboBox">
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Foreground"      Value="{StaticResource C.Gray800}"/>
            <Setter Property="Background"      Value="{StaticResource C.White}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource C.Gray200}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="FocusShadow" CornerRadius="10" Background="Transparent" Opacity="0">
                                <Border.Effect>
                                    <DropShadowEffect Color="#22C55E" Opacity="0.18" BlurRadius="10" ShadowDepth="0"/>
                                </Border.Effect>
                            </Border>
                            <Border x:Name="Root" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                                <Grid>
                                    <ToggleButton x:Name="PART_DropDownToggle" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False" ClickMode="Press" Background="Transparent" BorderThickness="0">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent">
                                                    <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{StaticResource C.Gray400}" StrokeThickness="1.5" 
                                                          HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <TextBox x:Name="PART_EditableTextBox" Margin="10,0,26,0" Background="Transparent" BorderThickness="0"
                                             Foreground="{StaticResource C.Gray800}" FontSize="12" VerticalAlignment="Center" Visibility="Hidden"/>
                                    <ContentPresenter x:Name="ContentSite" Content="{TemplateBinding SelectionBoxItem}" Margin="10,0,26,0"
                                                      VerticalAlignment="Center" IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Slide">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}" MaxHeight="200"
                                        Background="White" BorderBrush="{StaticResource C.Gray200}" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0">
                                    <ScrollViewer Padding="4"><ItemsPresenter/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/><Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource C.Green600}"/><Setter TargetName="FocusShadow" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,6"/><Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Bg" CornerRadius="6" Margin="1" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="{StaticResource C.Green50}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bg" Property="Background" Value="{StaticResource C.Green100}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Margin="32,28,32,32" DataContext="{Binding VisitVM}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════ TITLE & STATS ══════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="12" Background="#DCFCE7" Margin="0,0,14,0">
                        <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#16A34A"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Bệnh Án" FontSize="36" FontWeight="Bold" Foreground="#111827"/>
                        <TextBlock Text="Quản lý hồ sơ khám bệnh trong hệ thống" FontSize="14" Foreground="#6B7280" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border CornerRadius="10" Background="White" BorderBrush="#D1FAE5" BorderThickness="1" Padding="16,8" Margin="0,0,12,0">
                    <Border.Effect><DropShadowEffect BlurRadius="10" Opacity="0.06" ShadowDepth="1"/></Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8EF;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#16A34A" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtTotalCount" FontSize="13" FontWeight="Bold" Foreground="#111827">
                            <Run Text="{Binding Visits.Count, Mode=OneWay}"/>
                            <Run Text=" lượt khám"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource IconBtn}" Margin="0,0,10,0" ToolTip="Làm mới" Click="Refresh_Click">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#16A34A"/>
                </Button>
                <Button Style="{StaticResource GreenBtn}" Click="Add_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="20" Height="20" CornerRadius="10" Background="#15803D" Margin="0,0,8,0">
                            <TextBlock Text="+" FontSize="15" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                        </Border>
                        <TextBlock Text="Tạo Bệnh Án Mới" FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ══════════════════ SEARCH BAR ══════════════════ -->
        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="360" HorizontalAlignment="Left" Height="40" Background="White" CornerRadius="10" BorderBrush="#D1FAE5" BorderThickness="1">
                <Border.Effect><DropShadowEffect BlurRadius="10" Opacity="0.06" ShadowDepth="1"/></Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#9CA3AF" Margin="13,0,8,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="13" Padding="0,0,12,0" TextChanged="Search_TextChanged"/>
                    <TextBlock IsHitTestVisible="False" Text="Tìm tên bệnh nhân, bác sĩ..." VerticalAlignment="Center" Grid.Column="1" Foreground="#9CA3AF" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <Border Grid.Column="2" Height="40" Background="White" CornerRadius="10" BorderBrush="#D1FAE5" BorderThickness="1">
                <Border.Effect><DropShadowEffect BlurRadius="10" Opacity="0.06" ShadowDepth="1"/></Border.Effect>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="#16A34A"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#9CA3AF" Margin="13,0,8,0" VerticalAlignment="Center"/>
                    <DatePicker x:Name="VisitDateFilter"
                                Grid.Column="1"
                                Style="{StaticResource FilterDatePickerStyle}"
                                SelectedDateChanged="VisitDateFilter_SelectedDateChanged"
                                VerticalContentAlignment="Center"
                                Padding="0,0,10,0"/>
                </Grid>
            </Border>

            <Button Grid.Column="4" Style="{StaticResource OutlineBtn}" Height="40" Click="FilterToday_Click">
                <TextBlock Text="Hôm nay" FontSize="13" FontWeight="SemiBold" Foreground="#166534" VerticalAlignment="Center"/>
            </Button>

            <Button Grid.Column="6" Style="{StaticResource OutlineBtn}" Height="40" Click="FilterAllDate_Click">
                <TextBlock Text="Tất cả" FontSize="13" FontWeight="SemiBold" Foreground="#166534" VerticalAlignment="Center"/>
            </Button>
        </Grid>

        <!-- ══════════════════ MAIN CONTENT ══════════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="4.8*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== LEFT: VISIT LIST ===== -->
            <Border x:Name="VisitListCard" Grid.Column="0" Background="White" CornerRadius="16" BorderBrush="{StaticResource C.Gray100}" BorderThickness="1">
                <Border.Effect><DropShadowEffect BlurRadius="20" Opacity="0.08" ShadowDepth="0"/></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F9FAFB" CornerRadius="16,16,0,0" Padding="16,12" BorderBrush="{StaticResource C.Gray100}" BorderThickness="0,0,0,1">
                        <TextBlock Text="DANH SÁCH LƯỢT KHÁM" FontSize="11" FontWeight="Bold" Foreground="{StaticResource C.Gray400}"/>
                    </Border>

                    <Grid Grid.Row="1">
                        <ListView x:Name="VisitGroupList"
                                  ItemsSource="{Binding Visits}"
                                  Background="White"
                                  BorderThickness="0"
                                  FocusVisualStyle="{x:Null}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  HorizontalContentAlignment="Stretch"
                                  SelectionMode="Single"
                                  SelectionChanged="VisitGroupList_SelectionChanged"
                                  ScrollViewer.ScrollChanged="OnScrollChanged"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel">
                            
                            <!-- Định nghĩa nhóm (Header của Waiting, InProgress, Completed) -->
                            <ListView.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="16,20,16,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="3" Height="14" CornerRadius="1.5" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Name}" Value="CHỜ KHÁM"><Setter Property="Background" Value="#F59E0B"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Name}" Value="ĐANG KHÁM"><Setter Property="Background" Value="#3B82F6"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Name}" Value="ĐÃ KHÁM"><Setter Property="Background" Value="#16A34A"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="ExtraBold" Foreground="{StaticResource C.Gray500}" VerticalAlignment="Center"/>
                                                    <Border Background="{StaticResource C.Gray100}" CornerRadius="8" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ItemCount}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource C.Gray400}"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListView.GroupStyle>

                            <!-- Định nghĩa từng dòng (Item) -->
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="10,2,10,2"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border x:Name="Bg" Background="Transparent" CornerRadius="12" Padding="12,10" BorderBrush="Transparent" BorderThickness="1">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="{StaticResource C.Gray50}"/>
                                                        <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource C.Gray100}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="{StaticResource C.Green50}"/>
                                                        <Setter TargetName="Bg" Property="BorderBrush" Value="#BBF7D0"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Time & Status Dot -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="{Binding FormattedTime}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource C.Gray800}"/>
                                            <Ellipse Width="6" Height="6" HorizontalAlignment="Left" Margin="1,4,0,0" Fill="{Binding StatusDotColor}"/>
                                        </StackPanel>

                                        <!-- Patient Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PatientName}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource C.Gray800}"/>
                                            <TextBlock Text="{Binding VisitTypeDisplay}" FontSize="11" Foreground="{StaticResource C.Gray400}" Margin="0,1,0,0"/>
                                        </StackPanel>

                                        <!-- Print Actions -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource IconBtn}" Width="28" Height="28" Margin="0,0,4,0" 
                                                    ToolTip="In nhanh đơn thuốc" 
                                                    Command="{Binding DataContext.VisitVM.ExportPrescriptionCommand, ElementName=Self}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="&#xE9F5;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#16A34A"/>
                                            </Button>
                                            <!-- Go Arrow -->
                                            <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource C.Gray200}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        
                        <TextBlock x:Name="VisitEmptyState" 
                                   Text="Chưa có bệnh án nào" 
                                   Foreground="{StaticResource C.Gray400}" 
                                   FontSize="14" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Top"
                                   Margin="0,60,0,0" 
                                   Visibility="Collapsed"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ===== RIGHT: DETAIL PANEL ===== -->
            <Border x:Name="DetailCard" Grid.Column="2" Background="White" CornerRadius="16" BorderBrush="{StaticResource C.Gray100}" BorderThickness="1">
                <Border.Effect><DropShadowEffect BlurRadius="30" Opacity="0.10" ShadowDepth="4" Color="#000"/></Border.Effect>
                <Grid>

                    <!-- EMPTY STATE -->
                    <StackPanel x:Name="DetailEmpty" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="80" Height="80" CornerRadius="24" Background="White" Margin="0,0,0,24" HorizontalAlignment="Center">
                            <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.08" Color="#16A34A"/></Border.Effect>
                            <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="36" Foreground="#4ADE80" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Chưa chọn bệnh án" FontSize="20" FontWeight="SemiBold" Foreground="#111827" HorizontalAlignment="Center"/>
                        <TextBlock Text="Chọn một lượt khám từ danh sách bên trái để xem chi tiết." FontSize="14" Foreground="#6B7280" Margin="0,10,0,0" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="260" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- LOADING STATE -->
                    <StackPanel x:Name="DetailLoading" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE701;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="#86EFAC" HorizontalAlignment="Center"/>
                        <TextBlock Text="Đang tải..." FontSize="14" Foreground="#9CA3AF" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- DETAIL FORM -->
                    <ScrollViewer x:Name="DetailForm" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24">
                        <StackPanel>

                            <!-- Patient header -->
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="60" Height="60" CornerRadius="14" Background="#DCFCE7" Margin="0,0,16,0" VerticalAlignment="Top">
                                    <TextBlock x:Name="DetailAvatar" Text="?" FontSize="24" FontWeight="Bold" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="DetailPatientName" FontSize="24" FontWeight="Bold" Foreground="#111827"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource OutlineBtn}" Height="32" Margin="0,0,8,0" 
                                                    ToolTip="In Bệnh Án (A4)" 
                                                    Command="{Binding ExportMedicalRecordCommand}"
                                                    CommandParameter="{Binding SelectedItem, ElementName=VisitGroupList}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="In Bệnh Án" FontSize="11" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource GreenBtn}" Height="32" Margin="0,0,8,0" 
                                                    ToolTip="In Đơn Thuốc (A5)" 
                                                    Command="{Binding ExportPrescriptionCommand}"
                                                    CommandParameter="{Binding SelectedItem, ElementName=VisitGroupList}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE9F5;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="In Đơn Thuốc" FontSize="11" Foreground="White" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource IconBtn}" Width="32" Height="32" 
                                                    ToolTip="Chỉnh sửa chuyên sâu" Click="Edit_Click">
                                                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#16A34A"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock x:Name="DetailPatientGender" FontSize="14" Foreground="#6B7280" Margin="0,0,12,0"/>
                                        <TextBlock x:Name="DetailPatientAge" FontSize="14" Foreground="#6B7280" Margin="0,0,12,0"/>
                                        <TextBlock x:Name="DetailPatientId" FontSize="14" Foreground="#9CA3AF"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <Border Height="1.5" Background="#F3F4F6" Margin="0,0,0,20"/>

                            <!-- STATUS SELECTOR -->
                            <Border Style="{StaticResource DetailCardStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <Border Width="4" Height="18" CornerRadius="3" Background="#16A34A" Margin="0,0,10,0"/>
                                        <TextBlock Text="TRẠNG THÁI" FontSize="11" FontWeight="Bold" Foreground="{StaticResource C.Gray600}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnWaiting" Style="{StaticResource StatusBtn}" Background="#FEF3C7" BorderBrush="#FDE68A" Foreground="#92400E" Content="Chờ khám" Margin="0,0,10,0" Click="StatusWaiting_Click"/>
                                        <Button x:Name="BtnInProgress" Style="{StaticResource StatusBtn}" Background="#DBEAFE" BorderBrush="#BFDBFE" Foreground="#1D4ED8" Content="Đang khám" Margin="0,0,10,0" Click="StatusInProgress_Click"/>
                                        <Button x:Name="BtnCompleted" Style="{StaticResource StatusBtn}" Background="#D1FAE5" BorderBrush="#BBF7D0" Foreground="#166534" Content="Đã khám" Click="StatusCompleted_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- VITALS -->
                            <Border Style="{StaticResource DetailCardStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <Border Width="4" Height="18" CornerRadius="3" Margin="0,0,10,0">
                                            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#EF4444" Offset="0"/><GradientStop Color="#F97316" Offset="1"/></LinearGradientBrush></Border.Background>
                                        </Border>
                                        <TextBlock Text="SINH HIỆU" FontSize="11" FontWeight="Bold" Foreground="{StaticResource C.Gray600}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="Mạch" Style="{StaticResource FormLabel}" Margin="0"/><TextBlock Text=" (l/p)" Style="{StaticResource UnitLabel}" VerticalAlignment="Bottom" Margin="2,0,0,1"/>
                                            </StackPanel>
                                            <TextBox x:Name="InputPulse" Style="{StaticResource InputField}" Height="40" Padding="12,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="HA" Style="{StaticResource FormLabel}" Margin="0"/><TextBlock Text=" (mmHg)" Style="{StaticResource UnitLabel}" VerticalAlignment="Bottom" Margin="2,0,0,1"/>
                                            </StackPanel>
                                            <TextBox x:Name="InputBloodPressure" Style="{StaticResource InputField}" Height="40" Padding="12,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="Nhiệt Độ" Style="{StaticResource FormLabel}" Margin="0"/><TextBlock Text=" (°C)" Style="{StaticResource UnitLabel}" VerticalAlignment="Bottom" Margin="2,0,0,1"/>
                                            </StackPanel>
                                            <TextBox x:Name="InputTemperature" Style="{StaticResource InputField}" Height="40" Padding="12,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="6">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="Cân Nặng" Style="{StaticResource FormLabel}" Margin="0"/><TextBlock Text=" (kg)" Style="{StaticResource UnitLabel}" VerticalAlignment="Bottom" Margin="2,0,0,1"/>
                                            </StackPanel>
                                            <TextBox x:Name="InputWeight" Style="{StaticResource InputField}" Height="40" Padding="12,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- SYMPTOMS -->
                            <Border Style="{StaticResource DetailCardStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <Border Width="4" Height="18" CornerRadius="3" Background="#F59E0B" Margin="0,0,10,0"/>
                                        <TextBlock Text="TRIỆU CHỨNG" FontSize="11" FontWeight="Bold" Foreground="{StaticResource C.Gray600}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBox x:Name="InputSymptoms" Style="{StaticResource MultiLineField}"/>
                                </StackPanel>
                            </Border>

                            <!-- DIAGNOSIS -->
                            <Border Style="{StaticResource DetailCardStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <Border Width="4" Height="18" CornerRadius="3" Background="#3B82F6" Margin="0,0,10,0"/>
                                        <TextBlock Text="CHẨN ĐOÁN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource C.Gray600}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBox x:Name="InputDiagnosis" Style="{StaticResource MultiLineField}"/>
                                </StackPanel>
                            </Border>

                            <!-- MEDICINE LIST -->
                            <Border Style="{StaticResource DetailCardStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="4" Height="18" CornerRadius="3" Background="#EC4899" Margin="0,0,10,0"/>
                                            <TextBlock Text="ĐƠN THUỐC" FontSize="11" FontWeight="Bold" Foreground="{StaticResource C.Gray600}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource OutlineBtn}" Height="34" Padding="14,0"
                                                Click="AddMedicineDetail_Click">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="+" FontSize="16" FontWeight="SemiBold" Foreground="#16A34A" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Thêm thuốc" FontSize="12" FontWeight="SemiBold" Foreground="#16A34A" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Medicine table header -->
                                    <Border Background="#F9FAFB" CornerRadius="10" Padding="16,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="180"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="TÊN THUỐC" FontSize="11" FontWeight="Bold" Foreground="{StaticResource C.Gray400}"/>
                                            <TextBlock Text="SL" Grid.Column="1" FontSize="11" FontWeight="Bold" Foreground="{StaticResource C.Gray400}"/>
                                            <TextBlock Text="GHI CHÚ" Grid.Column="2" FontSize="11" FontWeight="Bold" Foreground="{StaticResource C.Gray400}"/>
                                        </Grid>
                                    </Border>

                                    <ItemsControl x:Name="MedicineList" ItemsSource="{Binding SelectedPrescriptionDetails, ElementName=Self}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="16,8,16,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="40"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <TextBlock Text="{Binding Medicine.MedicineName}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#111827"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Quantity}" FontSize="13" VerticalAlignment="Center" Foreground="#374151"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Dosage}" FontSize="12" Foreground="#6B7280" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                    
                                                    <Button Grid.Column="3" Style="{StaticResource IconBtn}" Width="24" Height="24" Tag="{Binding}" ToolTip="Xóa thuốc này" Click="RemoveMedicineDetail_Click">
                                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#EF4444"/>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    
                                    <!-- QUICK ADD MEDICINE AREA -->
                                    <Border x:Name="QuickAddMedicineArea" Visibility="Collapsed" Background="#F9FAFB" CornerRadius="8" Padding="12" Margin="0,8,0,0" BorderBrush="#E5E7EB" BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Margin="0,0,8,0">
                                                <TextBlock Text="Chọn thuốc" FontSize="11" FontWeight="Bold" Foreground="{StaticResource C.Gray500}" Margin="0,0,0,4"/>
                                                <ComboBox x:Name="QuickMedicineCombo" Height="32"
                                                          IsEditable="True" IsTextSearchEnabled="False"
                                                          StaysOpenOnEdit="True"
                                                          SelectionChanged="SearchComboBox_SelectionChanged"
                                                          LostKeyboardFocus="SearchComboBox_LostKeyboardFocus">
                                                    <ComboBox.Resources>
                                                        <Style TargetType="TextBox">
                                                            <Setter Property="Padding" Value="8,0"/>
                                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                            <Setter Property="FontSize" Value="12"/>
                                                        </Style>
                                                    </ComboBox.Resources>
                                                </ComboBox>
                                            </StackPanel>
                                            
                                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                <TextBlock Text="Số lượng" FontSize="11" FontWeight="Bold" Foreground="{StaticResource C.Gray500}" Margin="0,0,0,4"/>
                                                <TextBox x:Name="QuickMedicineQty" Height="32" VerticalContentAlignment="Center"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,8,0">
                                                <TextBlock Text="Cách dùng / Liều dùng" FontSize="11" FontWeight="Bold" Foreground="{StaticResource C.Gray500}" Margin="0,0,0,4"/>
                                                <TextBox x:Name="QuickMedicineDosage" Height="32" VerticalContentAlignment="Center"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                                <Button Content="Hủy" Click="CancelQuickAdd_Click" Style="{StaticResource OutlineBtn}" Height="32" Padding="12,0" Margin="0,0,4,0"/>
                                                <Button Content="Lưu" Click="ConfirmQuickAdd_Click" Style="{StaticResource GreenBtn}" Height="32" Padding="16,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <TextBlock x:Name="MedicineEmpty" Text="Chưa có đơn thuốc nào." FontSize="13" Foreground="{StaticResource C.Gray400}" HorizontalAlignment="Center" Margin="0,16,0,8" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>

                            <!-- NOTE -->
                            <Border Style="{StaticResource DetailCardStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <Border Width="4" Height="18" CornerRadius="3" Background="{StaticResource C.Gray400}" Margin="0,0,10,0"/>
                                        <TextBlock Text="GHI CHÚ CHUNG" FontSize="11" FontWeight="Bold" Foreground="{StaticResource C.Gray600}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBox x:Name="InputNote" Style="{StaticResource InputField}" Height="66" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="12,10"/>
                                </StackPanel>
                            </Border>

                            <!-- ACTION BUTTONS -->
                            <Grid Margin="0,10,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource CancelBtnStyle}" Click="CancelDetail_Click" Foreground="{StaticResource C.Gray600}" FontWeight="SemiBold" FontSize="13" Content="Huỷ Thay Đổi"/>
                                <Button Grid.Column="2" Style="{StaticResource SaveBtnStyle}" Click="Save_Click" Foreground="White" FontWeight="SemiBold" FontSize="13">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="Lưu Bệnh Án" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
