<UserControl x:Class="ClinicMS.Views.PatientFormDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="950"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>

        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrushSecondary}"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>

        <Style x:Key="UnitLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrushTertiary}"/>
        </Style>

        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextBrushPrimary}"/>
            <Setter Property="Background"      Value="{DynamicResource SurfaceBrushWhite}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrushLight}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding"         Value="12,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="FocusShadow" CornerRadius="10" Background="Transparent" Opacity="0">
                                <Border.Effect><StaticResource ResourceKey="FocusShadow"/></Border.Effect>
                            </Border>

                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Padding="{TemplateBinding Padding}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#86EFAC"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource PrimaryGreenBrush}"/>
                                <Setter TargetName="Root" Property="Background"  Value="{DynamicResource PrimaryGreenVeryLightBrush}"/>
                                <Setter TargetName="FocusShadow" Property="Background" Value="{DynamicResource PrimaryGreenVeryLightBrush}"/>
                                <Setter TargetName="FocusShadow" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormComboBox" TargetType="ComboBox">
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextBrushPrimary}"/>
            <Setter Property="Background"      Value="{DynamicResource SurfaceBrushWhite}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrushLight}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Height"          Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="FocusShadow" CornerRadius="10" Background="Transparent" Opacity="0">
                                <Border.Effect>
                                    <DropShadowEffect Color="#22C55E" Opacity="0.18" BlurRadius="10" ShadowDepth="0"/>
                                </Border.Effect>
                            </Border>

                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="ContentSite"
                                                      Grid.Column="0"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      Margin="12,0,0,0"
                                                      VerticalAlignment="Center"
                                                      IsHitTestVisible="False"/>
                                    <Path Grid.Column="1"
                                          Data="M 0 0 L 5 5 L 10 0"
                                          Stroke="{DynamicResource TextBrushTertiary}"
                                          StrokeThickness="1.8"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#FFFFFF"
                                        BorderBrush="{DynamicResource BorderBrushLight}"
                                        BorderThickness="1.5"
                                        CornerRadius="12"
                                        Margin="0,4,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.10" BlurRadius="20" ShadowDepth="4"/>
                                    </Border.Effect>
                                    <ScrollViewer Padding="6">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#86EFAC"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource PrimaryGreenBrush}"/>
                                <Setter TargetName="Root" Property="Background"  Value="{DynamicResource PrimaryGreenVeryLightBrush}"/>
                                <Setter TargetName="FocusShadow" Property="Background" Value="{DynamicResource PrimaryGreenVeryLightBrush}"/>
                                <Setter TargetName="FocusShadow" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding"    Value="12,9"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrushPrimary}"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7" Margin="2,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PrimaryGreenVeryLightBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryGreenDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PrimaryGreenLightBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryGreenDarkBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillRadio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="ShadowLayer" CornerRadius="10" Background="Transparent" Opacity="0">
                                <Border.Effect>
                                    <DropShadowEffect Color="#22C55E" Opacity="0.18" BlurRadius="8" ShadowDepth="0"/>
                                </Border.Effect>
                            </Border>

                            <Border x:Name="Pill"
                                    Background="{DynamicResource SurfaceBrushWhite}"
                                    BorderBrush="{DynamicResource BorderBrushLight}"
                                    BorderThickness="1.5"
                                    CornerRadius="10"
                                    Padding="18,9">
                                <TextBlock x:Name="Lbl"
                                           Text="{TemplateBinding Content}"
                                           FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource TextBrushSecondary}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background"    Value="{DynamicResource PrimaryGreenLightBrush}"/>
                                <Setter TargetName="Pill" Property="BorderBrush"   Value="{DynamicResource PrimaryGreenBrush}"/>
                                <Setter TargetName="Lbl"  Property="Foreground"    Value="{DynamicResource PrimaryGreenDarkBrush}"/>
                                <Setter TargetName="Lbl"  Property="FontWeight"    Value="SemiBold"/>
                                <Setter TargetName="ShadowLayer" Property="Background" Value="{DynamicResource PrimaryGreenLightBrush}"/>
                                <Setter TargetName="ShadowLayer" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="BorderBrush" Value="#86EFAC"/>
                                <Setter TargetName="Pill" Property="Background"  Value="{DynamicResource PrimaryGreenVeryLightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DatePickerTextBox" TargetType="DatePickerTextBox">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePickerTextBox">
                        <Border Background="Transparent" BorderThickness="0">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Background="Transparent" BorderThickness="0"
                                          Padding="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormDatePicker" TargetType="DatePicker">
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextBrushPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Padding"         Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Grid Height="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <DatePickerTextBox x:Name="PART_TextBox"
                                               Grid.Column="0"
                                               Style="{StaticResource DatePickerTextBox}"
                                               Foreground="{DynamicResource TextBrushPrimary}"
                                               FontSize="13" Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Background="Transparent" BorderThickness="0"/>
                            <Button x:Name="PART_Button" Grid.Column="1"
                                    Focusable="False" Width="28" Height="28"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="IconBg" CornerRadius="7" Background="Transparent">
                                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="14" Foreground="{DynamicResource TextBrushTertiary}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="IconBg" Property="Background" Value="{DynamicResource PrimaryGreenVeryLightBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Popup x:Name="PART_Popup" Grid.Column="0"
                                   AllowsTransparency="True" Placement="Bottom"
                                   StaysOpen="False">
                                <Border Background="White"
                                        BorderBrush="{DynamicResource BorderBrushLight}"
                                        BorderThickness="1.5" CornerRadius="12" Margin="0,4,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.10" BlurRadius="20" ShadowDepth="4"/>
                                    </Border.Effect>
                                    <Calendar x:Name="PART_Calendar"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid x:Name="Overlay" Background="#01000000" MouseLeftButtonDown="Overlay_Click">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="950">
            <Border CornerRadius="20" Background="{DynamicResource SurfaceBrushWhite}">
                <Border.Effect><StaticResource ResourceKey="ElevatedShadow"/></Border.Effect>
            </Border>

            <Border x:Name="DialogRoot" CornerRadius="20" ClipToBounds="True" Background="{DynamicResource SurfaceBrushWhite}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" CornerRadius="20,20,0,0" Padding="26,18">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#15803D" Offset="0"/>
                                <GradientStop Color="#16A34A" Offset="0.5"/>
                                <GradientStop Color="#22C55E" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Ellipse Width="120" Height="120"
                                     HorizontalAlignment="Right" VerticalAlignment="Top"
                                     Margin="0,-40,-30,0" Opacity="0.08" Fill="White"/>
                            <Ellipse Width="70" Height="70"
                                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                     Margin="0,0,60,-20" Opacity="0.06" Fill="White"/>

                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="46" Height="46" CornerRadius="13" Margin="0,0,14,0">
                                        <Border.Background>
                                            <SolidColorBrush Color="White" Opacity="0.15"/>
                                        </Border.Background>
                                        <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="20" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="TitleText" Text="Thêm Bệnh Nhân Mới"
                                                   FontSize="17" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock x:Name="SubtitleText" Text="Điền đầy đủ thông tin bệnh nhân"
                                                   FontSize="12" Foreground="#BBF7D0" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Width="32" Height="32" Cursor="Hand" Click="Close_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" CornerRadius="9" Background="#26FFFFFF">
                                                <TextBlock Text="✕" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="#ECFDF5"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#3AFFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#55FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" Background="#EDEEF0" VerticalScrollBarVisibility="Auto">
                        <Grid Margin="20,18,20,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Border Background="{DynamicResource SurfaceBrushWhite}" CornerRadius="16">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="18" ShadowDepth="3"/>
                                    </Border.Effect>
                                </Border>

                                <Border Background="{DynamicResource SurfaceBrushWhite}" CornerRadius="16" Padding="20"
                                        BorderBrush="{DynamicResource BackgroundBrushDark}" BorderThickness="1">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <Border Width="4" Height="18" CornerRadius="3" Margin="0,0,10,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#16A34A" Offset="0"/>
                                                        <GradientStop Color="#22C55E" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <TextBlock Text="THÔNG TIN CÁ NHÂN" FontSize="11" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextBrushSecondary}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Style="{StaticResource FormLabel}">Họ và Tên<Run Text=" *" Foreground="{DynamicResource ErrorBrush}"/></TextBlock>
                                                <TextBox x:Name="NameBox" Style="{StaticResource FormTextBox}" Height="40" Padding="12,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource FormLabel}">Ngày Sinh<Run Text=" *" Foreground="{DynamicResource ErrorBrush}"/></TextBlock>
                                                <Border x:Name="DobBorder" CornerRadius="10" BorderBrush="{DynamicResource BorderBrushLight}"
                                                        BorderThickness="1.5" Background="{DynamicResource SurfaceBrushWhite}" Height="40"
                                                        MouseEnter="DobBorder_MouseEnter" MouseLeave="DobBorder_MouseLeave">
                                                    <DatePicker x:Name="DobPicker" Style="{StaticResource FormDatePicker}"
                                                                GotFocus="DobPicker_GotFocus" LostFocus="DobPicker_LostFocus"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Margin="0,0,0,14">
                                            <TextBlock Style="{StaticResource FormLabel}">Giới Tính<Run Text=" *" Foreground="{DynamicResource ErrorBrush}"/></TextBlock>
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="GenderNam"   Content="Nam"  GroupName="Gender" Style="{StaticResource PillRadio}" IsChecked="True"/>
                                                <RadioButton x:Name="GenderNu"    Content="Nữ"   GroupName="Gender" Style="{StaticResource PillRadio}"/>
                                                <RadioButton x:Name="GenderOther" Content="Khác" GroupName="Gender" Style="{StaticResource PillRadio}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="1.4*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Style="{StaticResource FormLabel}">Số Điện Thoại<Run Text=" *" Foreground="{DynamicResource ErrorBrush}"/></TextBlock>
                                                <TextBox x:Name="PhoneBox" Style="{StaticResource FormTextBox}" Height="40" Padding="12,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Email" Style="{StaticResource FormLabel}"/>
                                                <TextBox x:Name="EmailBox" Style="{StaticResource FormTextBox}" Height="40" Padding="12,0"/>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel>
                                            <TextBlock Text="Địa Chỉ" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="AddressBox" Style="{StaticResource FormTextBox}" Height="40" Padding="12,0"/>
                                        </StackPanel>

                                    </StackPanel>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Column="2">

                                <Grid Margin="0,0,0,14">
                                    <Border Background="{DynamicResource SurfaceBrushWhite}" CornerRadius="16">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="18" ShadowDepth="3"/>
                                        </Border.Effect>
                                    </Border>
                                    <Border Background="{DynamicResource SurfaceBrushWhite}" CornerRadius="16" Padding="20"
                                            BorderBrush="{DynamicResource BackgroundBrushDark}" BorderThickness="1">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                                <Border Width="4" Height="18" CornerRadius="3" Margin="0,0,10,0">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#EF4444" Offset="0"/>
                                                            <GradientStop Color="#F97316" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <TextBlock Text="CHỈ SỐ SỨC KHỎE" FontSize="11" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextBrushSecondary}" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <StackPanel Margin="0,0,0,14">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="&#xEA37;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                    <TextBlock Text="Nhóm Máu" Style="{StaticResource FormLabel}" Margin="0"/>
                                                </StackPanel>
                                                <ComboBox x:Name="BloodTypeBox" Style="{StaticResource FormComboBox}">
                                                    <ComboBoxItem Content=""/>
                                                    <ComboBoxItem Content="A+"/>
                                                    <ComboBoxItem Content="A-"/>
                                                    <ComboBoxItem Content="B+"/>
                                                    <ComboBoxItem Content="B-"/>
                                                    <ComboBoxItem Content="AB+"/>
                                                    <ComboBoxItem Content="AB-"/>
                                                    <ComboBoxItem Content="O+"/>
                                                    <ComboBoxItem Content="O-"/>
                                                </ComboBox>
                                            </StackPanel>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <TextBlock Text="Chiều Cao" Style="{StaticResource FormLabel}" Margin="0"/>
                                                        <TextBlock Text=" (cm)" Style="{StaticResource UnitLabel}" VerticalAlignment="Bottom" Margin="2,0,0,1"/>
                                                    </StackPanel>
                                                    <TextBox x:Name="HeightBox" Style="{StaticResource FormTextBox}" Height="40" Padding="12,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <TextBlock Text="Cân Nặng" Style="{StaticResource FormLabel}" Margin="0"/>
                                                        <TextBlock Text=" (kg)" Style="{StaticResource UnitLabel}" VerticalAlignment="Bottom" Margin="2,0,0,1"/>
                                                    </StackPanel>
                                                    <TextBox x:Name="WeightBox" Style="{StaticResource FormTextBox}" Height="40" Padding="12,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid>
                                    <Border Background="{DynamicResource SurfaceBrushWhite}" CornerRadius="16">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="18" ShadowDepth="3"/>
                                        </Border.Effect>
                                    </Border>
                                    <Border Background="{DynamicResource SurfaceBrushWhite}" CornerRadius="16" Padding="20"
                                            BorderBrush="{DynamicResource BackgroundBrushDark}" BorderThickness="1">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                                <Border Width="4" Height="18" CornerRadius="3" Margin="0,0,10,0">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#0EA5E9" Offset="0"/>
                                                            <GradientStop Color="#6366F1" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <TextBlock Text="GHI CHÚ" FontSize="11" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextBrushSecondary}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBox x:Name="NotesBox" Style="{StaticResource FormTextBox}"
                                                     Height="140" TextWrapping="Wrap" AcceptsReturn="True"
                                                     VerticalContentAlignment="Top" Padding="12,10"
                                                     VerticalScrollBarVisibility="Auto"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="{DynamicResource SurfaceBrushWhite}"
                            BorderBrush="{DynamicResource BackgroundBrushDark}" BorderThickness="0,1.5,0,0"
                            CornerRadius="0,0,20,20" Padding="26,14">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource ErrorBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Trường bắt buộc" FontSize="12" Foreground="{DynamicResource TextBrushTertiary}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button Width="90" Height="38" Margin="0,0,10,0" Cursor="Hand" Click="Cancel_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" CornerRadius="10" Background="{DynamicResource SurfaceBrushWhite}"
                                                    BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1.5">
                                                <TextBlock Text="Hủy" FontSize="13" FontWeight="Medium"
                                                           Foreground="{DynamicResource TextBrushSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BackgroundBrushLight}"/>
                                                    <Setter TargetName="Bg" Property="BorderBrush" Value="#D1D5DB"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BackgroundBrushDark}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button x:Name="SaveBtn" Height="38" Padding="22,0" Cursor="Hand" Click="Save_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid x:Name="RootGrid">
                                                <Border CornerRadius="10">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#16A34A" Offset="0"/>
                                                            <GradientStop Color="#22C55E" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#16A34A" Opacity="0.38" BlurRadius="14" ShadowDepth="2"/>
                                                    </Border.Effect>
                                                </Border>

                                                <Border CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#16A34A" Offset="0"/>
                                                            <GradientStop Color="#22C55E" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="13" Foreground="White" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                        <TextBlock x:Name="SaveLabel" Text="Lưu Bệnh Nhân"
                                                                   FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RootGrid" Property="Opacity" Value="0.88"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="RootGrid" Property="Opacity" Value="0.72"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>