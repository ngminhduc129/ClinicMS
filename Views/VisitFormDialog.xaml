<UserControl x:Class="ClinicMS.Views.VisitFormDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Width="1024" Height="600"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>

        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrushSecondary}"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>

        <Style x:Key="UnitLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrushTertiary}"/>
        </Style>

        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextBrushPrimary}"/>
            <Setter Property="Background"      Value="{DynamicResource SurfaceBrushWhite}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrushLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="12,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="FocusShadow" CornerRadius="10" Background="Transparent" Opacity="0">
                                <Border.Effect>
                                    <DropShadowEffect Color="#22C55E" Opacity="0.12" BlurRadius="8" ShadowDepth="0"/>
                                </Border.Effect>
                            </Border>

                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Padding="{TemplateBinding Padding}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#86EFAC"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource PrimaryGreenBrush}"/>
                                <Setter TargetName="Root" Property="Background"  Value="White"/>
                                <Setter TargetName="FocusShadow" Property="Background" Value="White"/>
                                <Setter TargetName="FocusShadow" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormComboBox" TargetType="ComboBox">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextBrushPrimary}"/>
            <Setter Property="Background"      Value="{DynamicResource SurfaceBrushWhite}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrushLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height"          Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- Shadow Layer -->
                            <Border x:Name="FocusShadow" CornerRadius="10" Background="Transparent" Opacity="0">
                                <Border.Effect>
                                    <DropShadowEffect Color="#22C55E" Opacity="0.12" BlurRadius="10" ShadowDepth="0"/>
                                </Border.Effect>
                            </Border>

                            <!-- Main Rounded Border -->
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"
                                    SnapsToDevicePixels="True"
                                    ClipToBounds="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Dropdown Arrow Button -->
                                    <ToggleButton x:Name="PART_DropDownToggle" 
                                                  Grid.ColumnSpan="2"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False" ClickMode="Press" Background="Transparent" BorderThickness="0">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent">
                                                    <Path x:Name="Arrow" Data="M 0 0 L 4 4 L 8 0" 
                                                          Stroke="{DynamicResource TextBrushTertiary}" StrokeThickness="1.5" 
                                                          HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" 
                                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>

                                    <!-- Selection Display (Non-editable) -->
                                    <ContentPresenter x:Name="ContentSite"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      Margin="12,0,0,0"
                                                      VerticalAlignment="Center"
                                                      IsHitTestVisible="False"/>

                                    <!-- Editable Text Area (The Search Bar) -->
                                    <TextBox x:Name="PART_EditableTextBox"
                                             Margin="12,0,0,0"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{DynamicResource TextBrushPrimary}"
                                             FontSize="13"
                                             VerticalAlignment="Center"
                                             Visibility="Hidden"
                                             IsReadOnly="{TemplateBinding IsReadOnly}"
                                             Padding="0"/>
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#FFFFFF"
                                        BorderBrush="{DynamicResource BorderBrushLight}"
                                        BorderThickness="1.5"
                                        CornerRadius="12"
                                        Margin="0,4,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.10" BlurRadius="20" ShadowDepth="4"/>
                                    </Border.Effect>
                                    <ScrollViewer Padding="6" SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite"          Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#86EFAC"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource PrimaryGreenBrush}"/>
                                <Setter TargetName="Root" Property="Background"  Value="{DynamicResource PrimaryGreenVeryLightBrush}"/>
                                <Setter TargetName="FocusShadow" Property="Background" Value="{DynamicResource PrimaryGreenVeryLightBrush}"/>
                                <Setter TargetName="FocusShadow" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding"    Value="12,9"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrushPrimary}"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7" Margin="2,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PrimaryGreenVeryLightBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryGreenDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PrimaryGreenLightBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryGreenDarkBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillRadio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="ShadowLayer" CornerRadius="10" Background="Transparent" Opacity="0">
                                <Border.Effect>
                                    <DropShadowEffect Color="#22C55E" Opacity="0.18" BlurRadius="8" ShadowDepth="0"/>
                                </Border.Effect>
                            </Border>

                            <Border x:Name="Pill" Background="{DynamicResource SurfaceBrushWhite}"
                                    BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1.5"
                                    CornerRadius="10" Padding="14,8">
                                <TextBlock x:Name="Lbl" Text="{TemplateBinding Content}"
                                           FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextBrushSecondary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background"    Value="{DynamicResource PrimaryGreenLightBrush}"/>
                                <Setter TargetName="Pill" Property="BorderBrush"   Value="{DynamicResource PrimaryGreenBrush}"/>
                                <Setter TargetName="Lbl"  Property="Foreground"    Value="{DynamicResource PrimaryGreenDarkBrush}"/>
                                <Setter TargetName="Lbl"  Property="FontWeight"    Value="SemiBold"/>
                                <Setter TargetName="ShadowLayer" Property="Background" Value="{DynamicResource PrimaryGreenLightBrush}"/>
                                <Setter TargetName="ShadowLayer" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="BorderBrush" Value="#86EFAC"/>
                                <Setter TargetName="Pill" Property="Background"  Value="{DynamicResource PrimaryGreenVeryLightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DatePickerTextBox" TargetType="DatePickerTextBox">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePickerTextBox">
                        <Border Background="Transparent" BorderThickness="0">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Background="Transparent" BorderThickness="0"
                                          Padding="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormDatePicker" TargetType="DatePicker">
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextBrushPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Padding"         Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CalendarStyle">
                <Setter.Value>
                    <Style TargetType="Calendar"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Grid x:Name="PART_Root" Height="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <DatePickerTextBox x:Name="PART_TextBox"
                                               Grid.Column="0"
                                               Style="{StaticResource DatePickerTextBox}"
                                               Foreground="{DynamicResource TextBrushPrimary}"
                                               FontSize="13" Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Background="Transparent" BorderThickness="0"/>
                            <Button x:Name="PART_Button" Grid.Column="1"
                                    Focusable="False" Width="28" Height="28"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="IconBg" CornerRadius="7" Background="Transparent">
                                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="14" Foreground="{DynamicResource TextBrushTertiary}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="IconBg" Property="Background" Value="{DynamicResource PrimaryGreenVeryLightBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Popup x:Name="PART_Popup" Grid.Column="0"
                                   AllowsTransparency="True" Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=PART_Root}"
                                   StaysOpen="False">
                                <Border Background="White"
                                        BorderBrush="{DynamicResource BorderBrushLight}"
                                        BorderThickness="1.5" CornerRadius="12" Margin="0,4,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.10" BlurRadius="20" ShadowDepth="4"/>
                                    </Border.Effect>
                                    <Calendar x:Name="PART_Calendar" Style="{TemplateBinding CalendarStyle}"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid x:Name="Overlay" Background="#01000000" MouseLeftButtonDown="Overlay_Click">

        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="1024">
            <Border CornerRadius="20" Background="{DynamicResource SurfaceBrushWhite}">
                <Border.Effect><StaticResource ResourceKey="ElevatedShadow"/></Border.Effect>
            </Border>

            <Border x:Name="DialogRoot" CornerRadius="20" ClipToBounds="True" Background="{DynamicResource SurfaceBrushWhite}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" MinHeight="100" CornerRadius="20,20,0,0" Padding="26,24" SnapsToDevicePixels="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#16A34A" Offset="0"/>
                                <GradientStop Color="#15803D" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid VerticalAlignment="Top">
                            <Ellipse Width="120" Height="90"
                                     HorizontalAlignment="Right" VerticalAlignment="Top"
                                     Margin="0,-40,-30,0" Opacity="0.08">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="White"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Width="70" Height="70"
                                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                     Margin="0,0,60,-20" Opacity="0.06">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="White"/>
                                </Ellipse.Fill>
                            </Ellipse>

                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="46" Height="46" CornerRadius="13"
                                            Background="#33FFFFFF" Margin="0,0,14,0">
                                        <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="20" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="TitleText" Text="Thêm Hồ Sơ Khám"
                                                   FontSize="18" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock x:Name="SubtitleText" Text="Điền thông tin khám bệnh"
                                                   FontSize="12" Foreground="#BBF7D0" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Width="32" Height="32" Cursor="Hand" Click="Close_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" CornerRadius="16" Background="#26FFFFFF">
                                                <TextBlock Text="✕" FontSize="10" FontWeight="Bold"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#4DFFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" Background="{DynamicResource BackgroundBrushLight}" VerticalScrollBarVisibility="Hidden" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                        <Grid Margin="20,18,20,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Border Background="{DynamicResource SurfaceBrushWhite}" CornerRadius="16">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="18" ShadowDepth="3"/>
                                    </Border.Effect>
                                </Border>

                                <Border Background="{DynamicResource SurfaceBrushWhite}" CornerRadius="16" Padding="20"
                                        BorderBrush="{DynamicResource BackgroundBrushDark}" BorderThickness="1">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                            <Border Width="4" Height="18" CornerRadius="3" Margin="0,0,10,0" Background="{DynamicResource PrimaryGreenBrush}"/>
                                            <TextBlock Text="THÔNG TIN CHUNG" FontSize="11" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextBrushSecondary}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <TextBlock Style="{StaticResource FormLabel}">Bệnh Nhân<Run Text=" *" Foreground="{DynamicResource ErrorBrush}"/></TextBlock>
                                        <ComboBox x:Name="PatientNameBox" Style="{StaticResource FormComboBox}"
                                                  Margin="0,0,0,16" IsEditable="True" IsTextSearchEnabled="False"
                                                  StaysOpenOnEdit="True"
                                                  SelectionChanged="SearchComboBox_SelectionChanged"
                                                  LostKeyboardFocus="SearchComboBox_LostKeyboardFocus"/>

                                        <TextBlock Style="{StaticResource FormLabel}">Bác Sĩ<Run Text=" *" Foreground="{DynamicResource ErrorBrush}"/></TextBlock>
                                        <ComboBox x:Name="DoctorNameBox" Style="{StaticResource FormComboBox}"
                                                  Margin="0,0,0,16" IsEditable="True" IsTextSearchEnabled="False"
                                                  StaysOpenOnEdit="True"
                                                  SelectionChanged="SearchComboBox_SelectionChanged"
                                                  LostKeyboardFocus="SearchComboBox_LostKeyboardFocus"/>

                                        <TextBlock Text="Ngày Khám" Style="{StaticResource FormLabel}"/>
                                        <Border x:Name="DateBorder" CornerRadius="10" BorderBrush="{DynamicResource BorderBrushLight}"
                                                BorderThickness="1.5" Background="{DynamicResource SurfaceBrushWhite}" Height="40" Margin="0,0,0,16">
                                            <DatePicker x:Name="VisitDatePicker" Style="{StaticResource FormDatePicker}"/>
                                        </Border>

                                        <StackPanel Margin="0,0,0,4">
                                            <TextBlock Text="Loại Khám" Style="{StaticResource FormLabel}"/>
                                            <WrapPanel Margin="0,0,0,8">
                                                <RadioButton x:Name="RbWalkIn" Content="Trực tiếp" GroupName="VisitType" Style="{StaticResource PillRadio}" IsChecked="True"/>
                                                <RadioButton x:Name="RbAppt" Content="Hẹn lịch" GroupName="VisitType" Style="{StaticResource PillRadio}"/>
                                                <RadioButton x:Name="RbEmerg" Content="Cấp cứu" GroupName="VisitType" Style="{StaticResource PillRadio}"/>
                                                <RadioButton x:Name="RbFollow" Content="Tái khám" GroupName="VisitType" Style="{StaticResource PillRadio}"/>
                                            </WrapPanel>

                                            <TextBlock Text="Trạng Thái" Style="{StaticResource FormLabel}"/>
                                            <WrapPanel>
                                                <RadioButton x:Name="RbWaiting" Content="Chờ khám" GroupName="Status" Style="{StaticResource PillRadio}" IsChecked="True"/>
                                                <RadioButton x:Name="RbProgress" Content="Đang khám" GroupName="Status" Style="{StaticResource PillRadio}"/>
                                                <RadioButton x:Name="RbComplete" Content="Đã khám" GroupName="Status" Style="{StaticResource PillRadio}"/>
                                            </WrapPanel>
                                        </StackPanel>

                                        <Border Height="1" Background="{DynamicResource BackgroundBrushDark}" Margin="0,18,0,18"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <Border Width="4" Height="18" CornerRadius="3" Margin="0,0,10,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#EF4444" Offset="0"/>
                                                        <GradientStop Color="#F97316" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <TextBlock Text="SINH HIỆU" FontSize="11" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextBrushSecondary}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="&#xE95E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                    <TextBlock Text="Mạch" Style="{StaticResource FormLabel}" Margin="0"/>
                                                    <TextBlock Text=" (l/p)" Style="{StaticResource UnitLabel}" VerticalAlignment="Bottom" Margin="2,0,0,1"/>
                                                </StackPanel>
                                                <TextBox x:Name="PulseBox" Style="{StaticResource FormTextBox}" Height="40" Padding="12,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="&#xE9CE;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#F97316" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                    <TextBlock Text="Huyết Áp" Style="{StaticResource FormLabel}" Margin="0"/>
                                                </StackPanel>
                                                <TextBox x:Name="BPBox" Style="{StaticResource FormTextBox}" Height="40" Padding="12,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="&#xE9CA;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#3B82F6" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                    <TextBlock Text="Nhiệt Độ" Style="{StaticResource FormLabel}" Margin="0"/>
                                                </StackPanel>
                                                <TextBox x:Name="TempBox" Style="{StaticResource FormTextBox}" Height="40" Padding="12,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Grid.Column="2">
                                <Border Background="{DynamicResource SurfaceBrushWhite}" CornerRadius="16">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="18" ShadowDepth="3"/>
                                    </Border.Effect>
                                </Border>

                                <Border Background="{DynamicResource SurfaceBrushWhite}" CornerRadius="16" Padding="20"
                                        BorderBrush="{DynamicResource BackgroundBrushDark}" BorderThickness="1">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                            <Border Width="4" Height="18" CornerRadius="3" Margin="0,0,10,0" Background="#3B82F6"/>
                                            <TextBlock Text="LÂM SÀNG" FontSize="11" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextBrushSecondary}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <TextBlock Text="Triệu Chứng" Style="{StaticResource FormLabel}"/>
                                        <TextBox x:Name="SymptomsBox" Style="{StaticResource FormTextBox}"
                                                 Height="86" TextWrapping="Wrap" AcceptsReturn="True"
                                                 VerticalContentAlignment="Top" Padding="12,10" Margin="0,0,0,16"/>

                                        <Grid Margin="0,0,0,16">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="4" Height="18" Background="#6366F1" CornerRadius="2" Margin="0,0,10,0"/>
                                                <TextBlock Text="CHỈ ĐỊNH DỊCH VỤ" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextBrushPrimary}"/>
                                            </StackPanel>
                                            <Button HorizontalAlignment="Right" VerticalAlignment="Center" 
                                                    Click="AddService_Click" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="border" Background="White" BorderBrush="#6366F1" BorderThickness="1" CornerRadius="12" Padding="12,6">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="+" FontSize="16" Foreground="#6366F1" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Thêm dịch vụ" FontSize="13" Foreground="#6366F1" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="border" Property="Background" Value="#EEF2FF"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>

                                        <Border Background="{DynamicResource BackgroundBrushLight}" CornerRadius="10" Padding="16,10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="200"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="TÊN DỊCH VỤ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextBrushTertiary}"/>
                                                <TextBlock Grid.Column="1" Text="KẾT QUẢ (NẾU CÓ)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextBrushTertiary}"/>
                                            </Grid>
                                        </Border>

                                        <Border x:Name="ServiceInputArea" Background="White" 
                                                CornerRadius="12" Padding="20" Margin="0,0,0,16" 
                                                BorderThickness="1" BorderBrush="{DynamicResource BorderBrushLight}">
                                            <Border.Effect>
                                                <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="1" Opacity="0.05"/>
                                            </Border.Effect>
                                            <StackPanel>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Chọn dịch vụ" Style="{StaticResource FormLabel}" Margin="0,0,0,6"/>
                                                        <ComboBox x:Name="ServiceCombo" Style="{StaticResource FormComboBox}"
                                                                  IsEditable="True" IsTextSearchEnabled="False"
                                                                  StaysOpenOnEdit="True"
                                                                  SelectionChanged="SearchComboBox_SelectionChanged"
                                                                  LostKeyboardFocus="SearchComboBox_LostKeyboardFocus"/>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="Kết quả (nếu có)" Style="{StaticResource FormLabel}" Margin="0,0,0,6"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="ServiceResultBox" Style="{StaticResource FormTextBox}" Height="38" VerticalContentAlignment="Center" Padding="12,0"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                                                        <Button Width="70" Height="36" Margin="0,0,8,0" 
                                                                Click="CancelAddService_Click" Cursor="Hand">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Bg" CornerRadius="10" Background="White" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1.5">
                                                                        <TextBlock Text="Hủy" FontSize="12" FontWeight="Bold" 
                                                                                  Foreground="{DynamicResource TextBrushSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BackgroundBrushLight}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                        <Button Width="70" Height="36" 
                                                                Click="ConfirmAddService_Click" Cursor="Hand">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Bg" CornerRadius="10" Background="#6366F1">
                                                                        <TextBlock Text="Lưu" FontSize="12" FontWeight="Bold" 
                                                                                  Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Bg" Property="Opacity" Value="0.9"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <ListView x:Name="ServiceOrderListDialog" Margin="0,0,0,16" BorderThickness="0" Background="Transparent" d:ItemsSource="{d:SampleData ItemCount=1}">
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListViewItem">
                                                                <Border Background="Transparent" BorderBrush="{DynamicResource BorderBrushLight}" 
                                                                        BorderThickness="0,0,0,1" Padding="16,10">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="200"/>
                                                                            <ColumnDefinition Width="30"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{Binding Service.ServiceName}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrushPrimary}" VerticalAlignment="Center"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding Result}" FontSize="12" Foreground="{DynamicResource TextBrushSecondary}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                                                        <Button Grid.Column="2" Width="24" Height="24" Background="Transparent" BorderThickness="0" 
                                                                                Cursor="Hand" Click="RemoveService_Click" Tag="{Binding}" HorizontalAlignment="Right">
                                                                            <TextBlock Text="✕" FontSize="10" Foreground="{DynamicResource ErrorBrush}"/>
                                                                        </Button>
                                                                    </Grid>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                        </ListView>

                                        <TextBlock Text="Chẩn Đoán" Style="{StaticResource FormLabel}"/>
                                        <TextBox x:Name="DiagnosisBox" Style="{StaticResource FormTextBox}"
                                                 Height="86" TextWrapping="Wrap" AcceptsReturn="True"
                                                 VerticalContentAlignment="Top" Padding="12,10" Margin="0,0,0,20"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <Border Width="4" Height="18" CornerRadius="3" Margin="0,0,10,0" Background="#DB2777"/>
                                            <TextBlock Text="ĐƠN THUỐC" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextBrushPrimary}"/>
                                        </StackPanel>
                                        <Button HorizontalAlignment="Left" Margin="0,0,0,16" 
                                                Click="AddMedicine_Click" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" Background="White" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="12" Padding="12,6">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="+" FontSize="16" Foreground="#22C55E" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Thêm thuốc" FontSize="13" Foreground="#22C55E" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#F0FDF4"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <Border Background="{DynamicResource BackgroundBrushLight}" CornerRadius="10" Padding="16,10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="200"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="TÊN THUỐC" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextBrushTertiary}"/>
                                                <TextBlock Grid.Column="1" Text="SL" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextBrushTertiary}" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="GHI CHÚ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextBrushTertiary}"/>
                                            </Grid>
                                        </Border>

                                        <Border x:Name="MedicineInputArea" Background="White" 
                                                CornerRadius="12" Padding="20" Margin="0,0,0,16" 
                                                BorderThickness="1" BorderBrush="{DynamicResource BorderBrushLight}">
                                            <Border.Effect>
                                                <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="1" Opacity="0.05"/>
                                            </Border.Effect>
                                            <StackPanel>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="100"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,12,0">
                                                        <TextBlock Text="Chọn thuốc" Style="{StaticResource FormLabel}" Margin="0,0,0,6"/>
                                                        <ComboBox x:Name="MedicineCombo" Style="{StaticResource FormComboBox}"
                                                                  IsEditable="True" IsTextSearchEnabled="False"
                                                                  StaysOpenOnEdit="True"
                                                                  SelectionChanged="SearchComboBox_SelectionChanged"
                                                                  LostKeyboardFocus="SearchComboBox_LostKeyboardFocus"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="Số lượng" Style="{StaticResource FormLabel}" Margin="0,0,0,6"/>
                                                        <TextBox x:Name="MedicineQty" Style="{StaticResource FormTextBox}" Height="38" VerticalContentAlignment="Center" Padding="12,0"/>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="Cách dùng / Liều dùng" Style="{StaticResource FormLabel}" Margin="0,0,0,6"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="MedicineDosage" Style="{StaticResource FormTextBox}" Height="38" VerticalContentAlignment="Center" Padding="12,0"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                                                        <Button Width="70" Height="36" Margin="0,0,8,0" 
                                                                Click="CancelAddMedicine_Click" Cursor="Hand">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Bg" CornerRadius="10" Background="White" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1">
                                                                        <TextBlock Text="Hủy" FontSize="12" FontWeight="SemiBold" 
                                                                                 Foreground="{DynamicResource TextBrushSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BackgroundBrushLight}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                        <Button Width="70" Height="36" 
                                                                Click="ConfirmAddMedicine_Click" Cursor="Hand">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Bg" CornerRadius="10" Background="{DynamicResource PrimaryGreenBrush}">
                                                                        <TextBlock Text="Lưu" FontSize="12" FontWeight="Bold" 
                                                                                 Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Bg" Property="Opacity" Value="0.9"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <ListView x:Name="PrescriptionList" Margin="0,0,0,10" BorderThickness="0" Background="Transparent" d:ItemsSource="{d:SampleData ItemCount=1}">
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListViewItem">
                                                                <Border Background="Transparent" BorderBrush="{DynamicResource BorderBrushLight}" 
                                                                        BorderThickness="0,0,0,1" Padding="16,10">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="60"/>
                                                                            <ColumnDefinition Width="200"/>
                                                                            <ColumnDefinition Width="30"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{Binding Medicine.MedicineName}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrushPrimary}" VerticalAlignment="Center"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding Quantity}" 
                                                                                 FontWeight="SemiBold" Foreground="{DynamicResource TextBrushSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        <TextBlock Grid.Column="2" Text="{Binding Dosage}" FontSize="12" Foreground="{DynamicResource TextBrushSecondary}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                                                        <Button Grid.Column="3" Width="24" Height="24" Background="Transparent" BorderThickness="0" 
                                                                                Cursor="Hand" Click="RemoveMedicine_Click" Tag="{Binding}" HorizontalAlignment="Right">
                                                                            <TextBlock Text="✕" FontSize="10" Foreground="{DynamicResource ErrorBrush}"/>
                                                                        </Button>
                                                                    </Grid>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                        </ListView>

                                        <TextBlock Text="Ghi Chú Đơn Thuốc" Style="{StaticResource FormLabel}"/>
                                        <TextBox x:Name="PrescriptionBox" Style="{StaticResource FormTextBox}"
                                                 Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                                                 VerticalContentAlignment="Top" Padding="12,10" Margin="0,0,0,16"/>

                                        <TextBlock Text="Ghi Chú" Style="{StaticResource FormLabel}"/>
                                        <TextBox x:Name="NoteBox" Style="{StaticResource FormTextBox}"
                                                 Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                                                 VerticalContentAlignment="Top" Padding="12,10"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                        </Grid>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="{DynamicResource SurfaceBrushWhite}"
                            BorderBrush="{DynamicResource BackgroundBrushDark}" BorderThickness="0,1,0,0"
                            CornerRadius="0,0,20,20" Padding="26,16">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource ErrorBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock FontSize="12" Foreground="{DynamicResource TextBrushTertiary}" Text="Trường bắt buộc" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button Width="100" Height="40" Margin="0,0,12,0" Cursor="Hand" Click="Cancel_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" CornerRadius="10" Background="{DynamicResource SurfaceBrushWhite}"
                                                    BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1.5">
                                                <TextBlock Text="Hủy" FontSize="13" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextBrushSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BackgroundBrushLight}"/>
                                                    <Setter TargetName="Bg" Property="BorderBrush" Value="#D1D5DB"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button x:Name="SaveBtn" Height="40" Padding="24,0" Cursor="Hand" Click="Save_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid x:Name="RootGrid">
                                                <Border CornerRadius="10" Background="{DynamicResource PrimaryGreenBrush}">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#16A34A" Opacity="0.3" BlurRadius="12" ShadowDepth="2" Direction="270"/>
                                                    </Border.Effect>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,0">
                                                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="14" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        <TextBlock Text="Lưu Hồ Sơ" FontSize="13" FontWeight="Bold"
                                                                   Foreground="White" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RootGrid" Property="Opacity" Value="0.9"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="RootGrid" Property="Opacity" Value="0.8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>