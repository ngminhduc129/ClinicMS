<UserControl x:Class="ClinicMS.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             Background="#F0FDF4">
    <UserControl.Resources>
        <Style x:Key="ChartBar" TargetType="Border">
            <Setter Property="Background" Value="#22C55E"/>
            <Setter Property="CornerRadius" Value="4,4,0,0"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#16A34A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32" DataContext="{Binding DashboardVM}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock FontSize="26" FontWeight="Bold" Foreground="#111827">Hi 👋 Chào mừng đến với ClinicMS</TextBlock>
            <TextBlock FontSize="14" Foreground="#6B7280" Margin="0,6,0,0">Hệ thống quản lý phòng khám — dữ liệu lưu cục bộ, không cần internet.</TextBlock>
        </StackPanel>

        <!-- STATS CARDS -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20,24" Effect="{StaticResource StandardShadow}">
                <StackPanel>
                    <Border Width="44" Height="44" CornerRadius="10" Background="#CCFBF1" HorizontalAlignment="Left" Margin="0,0,0,14">
                        <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#0F766E"/>
                    </Border>
                    <TextBlock Text="{Binding TotalPatients}" FontSize="32" FontWeight="Bold" Foreground="#1F2937"/>
                    <TextBlock Text="Bệnh Nhân" FontSize="13" FontWeight="Medium" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20,24" Effect="{StaticResource StandardShadow}">
                <StackPanel>
                    <Border Width="44" Height="44" CornerRadius="10" Background="#CCFBF1" HorizontalAlignment="Left" Margin="0,0,0,14">
                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#0F766E"/>
                    </Border>
                    <TextBlock Text="{Binding TotalDoctors}" FontSize="32" FontWeight="Bold" Foreground="#1F2937"/>
                    <TextBlock Text="Bác Sĩ" FontSize="13" FontWeight="Medium" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Background="White" CornerRadius="12" Padding="20,24" Effect="{StaticResource StandardShadow}">
                <StackPanel>
                    <Border Width="44" Height="44" CornerRadius="10" Background="#FEF3C7" HorizontalAlignment="Left" Margin="0,0,0,14">
                        <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#B45309"/>
                    </Border>
                    <TextBlock Text="{Binding TotalVisits}" FontSize="32" FontWeight="Bold" Foreground="#1F2937"/>
                    <TextBlock Text="Tổng Hồ Sơ Khám" FontSize="13" FontWeight="Medium" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="6" Background="White" CornerRadius="12" Padding="20,24" Effect="{StaticResource StandardShadow}">
                <StackPanel>
                    <Border Width="44" Height="44" CornerRadius="10" Background="#E0F2FE" HorizontalAlignment="Left" Margin="0,0,0,14">
                        <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#0369A1"/>
                    </Border>
                    <TextBlock Text="{Binding VisitsToday}" FontSize="32" FontWeight="Bold" Foreground="#1F2937"/>
                    <TextBlock Text="Khám Hôm Nay" FontSize="13" FontWeight="Medium" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: CHART & UPCOMING APPOINTMENTS -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- WEEKLY CHART -->
                <Border Grid.Row="0" Background="White" CornerRadius="16" Padding="24" ClipToBounds="True" Effect="{StaticResource StandardShadow}">
                    <StackPanel>
                        <TextBlock Text="THỐNG KÊ 7 NGÀY QUA" FontSize="12" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,20"/>
                        <Grid Height="160">
                            <!-- Dashed grid lines -->
                            <Line HorizontalAlignment="Stretch" VerticalAlignment="Top" Y1="0" Y2="0" Stroke="#E5E7EB" StrokeDashArray="3,3" Opacity="0.5" StrokeThickness="1" Margin="8,40,8,0"/>
                            <Line HorizontalAlignment="Stretch" VerticalAlignment="Top" Y1="0" Y2="0" Stroke="#E5E7EB" StrokeDashArray="3,3" Opacity="0.5" StrokeThickness="1" Margin="8,80,8,0"/>
                            <Line HorizontalAlignment="Stretch" VerticalAlignment="Top" Y1="0" Y2="0" Stroke="#E5E7EB" StrokeDashArray="3,3" Opacity="0.5" StrokeThickness="1" Margin="8,120,8,0"/>

                            <!-- Baseline -->
                            <Border Height="1" Background="#E5E7EB" VerticalAlignment="Bottom" Margin="8,0,8,18"/>

                            <!-- Bars -->
                            <ItemsControl ItemsSource="{Binding WeeklyStats}" VerticalAlignment="Bottom">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="7" VerticalAlignment="Bottom"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Bottom">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Value}" FontSize="11" FontWeight="SemiBold" Foreground="#16A34A" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                <Border Style="{StaticResource ChartBar}">
                                                    <Border.Height>
                                                        <MultiBinding Converter="{StaticResource PercentageToHeightConverter}">
                                                            <Binding Path="Percentage"/><Binding Source="120"/>
                                                        </MultiBinding>
                                                    </Border.Height>
                                                </Border>
                                                <TextBlock Text="{Binding Label}" FontSize="10" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- UPCOMING APPOINTMENTS -->
                <Border Grid.Row="2" Background="White" CornerRadius="16" Padding="24" Margin="0,0,0,24" ClipToBounds="True" Effect="{StaticResource StandardShadow}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock Text="LỊCH HẸN SẮP TỚI" FontSize="12" FontWeight="Bold" Foreground="#9CA3AF"/>
                            <TextBlock Text="Các bệnh nhân đặt lịch trước" FontSize="11" Foreground="#D1D5DB" Margin="0,2,0,0"/>
                        </StackPanel>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding UpcomingAppointments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F9FAFB" BorderThickness="0,0,0,1" Padding="0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="8" Background="#FEF3C7" Margin="0,0,12,0">
                                                <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#D97706" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Patient.FullName}" FontWeight="Bold" FontSize="13" Foreground="#374151"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding AppointmentTime}" FontSize="11" Foreground="#9CA3AF"/>
                                                    <TextBlock Text=" • " FontSize="11" Foreground="#D1D5DB"/>
                                                    <TextBlock Text="{Binding Doctor.FullName}" FontSize="11" Foreground="#16A34A"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        
                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,24">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding UpcomingAppointments.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="48" Foreground="#D1D5DB" HorizontalAlignment="Center" Opacity="0.3"/>
                            <TextBlock Text="Không có lịch hẹn" Foreground="#D1D5DB" FontSize="13" HorizontalAlignment="Center" Margin="0,8,0,16"/>
                            <Button Style="{StaticResource OutlineBtn}" Click="AddAppointment_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="+" FontSize="16" FontWeight="Bold" Foreground="#16A34A" Margin="0,0,6,0"/>
                                    <TextBlock Text="Tạo lịch hẹn mới" FontSize="13" Foreground="#16A34A"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- RIGHT: TODAY'S VISITS LIST -->
            <Border Grid.Column="2" Background="White" CornerRadius="16" Padding="24" ClipToBounds="True" Effect="{StaticResource StandardShadow}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="BỆNH NHÂN KHÁM HÔM NAY" FontSize="12" FontWeight="Bold" Foreground="#9CA3AF"/>
                            <TextBlock Text="Đang chờ hoặc đã khám" FontSize="11" Foreground="#D1D5DB" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Click="Refresh_Click" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#9CA3AF"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <ListBox Grid.Row="1" ItemsSource="{Binding TodayVisits}" 
                             Background="Transparent" BorderThickness="0" 
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             HorizontalContentAlignment="Stretch" d:ItemsSource="{d:SampleData ItemCount=4}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bg" Background="Transparent" CornerRadius="12" Margin="0,0,0,8" Padding="12,10" BorderBrush="Transparent" BorderThickness="1">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#F9FAFB"/>
                                                    <Setter TargetName="Bg" Property="BorderBrush" Value="#F3F4F6"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Avatar / Icon based on Gender -->
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="{Binding GenderColor}" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding PatientGenderIcon}" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{Binding GenderIconColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Info -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PatientName, FallbackValue='Bệnh nhân'}" FontWeight="Bold" FontSize="13" Foreground="#1F2937" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding FormattedTime}" FontSize="11" Foreground="#6B7280" FontWeight="SemiBold"/>
                                            <TextBlock Text=" • " FontSize="11" Foreground="#D1D5DB"/>
                                            <TextBlock Text="{Binding VisitTypeDisplay, FallbackValue='Khám trực tiếp'}" FontSize="11" Foreground="#9CA3AF"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Status Badge -->
                                    <Border Grid.Column="2" CornerRadius="8" Padding="10,4" VerticalAlignment="Center"
                                            Background="{Binding Status, Converter={StaticResource StatusToBackground}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="9" FontWeight="Bold" VerticalAlignment="Center"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusToBrush}, FallbackValue=#3B82F6}"
                                                       Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding StatusDisplay}" FontSize="11" FontWeight="Bold"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusToBrush}, FallbackValue=#3B82F6}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty State -->
                    <TextBlock Grid.Row="1" Text="Trống" Foreground="#D1D5DB" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding TodayVisits.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
