<UserControl x:Class="ClinicMS.Views.VisitFormDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Width="1024" Height="600"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>

        <SolidColorBrush x:Key="C.Green700"  Color="#15803D"/>
        <SolidColorBrush x:Key="C.Green600"  Color="#16A34A"/>
        <SolidColorBrush x:Key="C.Green500"  Color="#22C55E"/>
        <SolidColorBrush x:Key="C.Green100"  Color="#DCFCE7"/>
        <SolidColorBrush x:Key="C.Green50"   Color="#F0FDF4"/>
        <SolidColorBrush x:Key="C.White"     Color="#FFFFFF"/>
        <SolidColorBrush x:Key="C.Gray50"    Color="#F9FAFB"/>
        <SolidColorBrush x:Key="C.Gray100"   Color="#F3F4F6"/>
        <SolidColorBrush x:Key="C.Gray200"   Color="#E5E7EB"/>
        <SolidColorBrush x:Key="C.Gray400"   Color="#9CA3AF"/>
        <SolidColorBrush x:Key="C.Gray600"   Color="#4B5563"/>
        <SolidColorBrush x:Key="C.Gray800"   Color="#1F2937"/>
        <SolidColorBrush x:Key="C.Red"       Color="#EF4444"/>
        <SolidColorBrush x:Key="C.Orange"    Color="#F97316"/>

        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource C.Gray600}"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>

        <Style x:Key="UnitLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{StaticResource C.Gray400}"/>
        </Style>

        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Foreground"      Value="{StaticResource C.Gray800}"/>
            <Setter Property="Background"      Value="{StaticResource C.White}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource C.Gray200}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding"         Value="12,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="FocusShadow" CornerRadius="10" Background="Transparent" Opacity="0">
                                <Border.Effect>
                                    <DropShadowEffect Color="#22C55E" Opacity="0.20" BlurRadius="10" ShadowDepth="0"/>
                                </Border.Effect>
                            </Border>

                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Padding="{TemplateBinding Padding}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#86EFAC"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource C.Green600}"/>
                                <Setter TargetName="Root" Property="Background"  Value="{StaticResource C.Green50}"/>
                                <Setter TargetName="FocusShadow" Property="Background" Value="{StaticResource C.Green50}"/>
                                <Setter TargetName="FocusShadow" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormComboBox" TargetType="ComboBox">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Foreground"      Value="{StaticResource C.Gray800}"/>
            <Setter Property="Background"      Value="{StaticResource C.White}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource C.Gray200}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Height"          Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- Shadow Layer -->
                            <Border x:Name="FocusShadow" CornerRadius="10" Background="Transparent" Opacity="0">
                                <Border.Effect>
                                    <DropShadowEffect Color="#22C55E" Opacity="0.18" BlurRadius="10" ShadowDepth="0"/>
                                </Border.Effect>
                            </Border>

                            <!-- Main Rounded Border -->
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"
                                    SnapsToDevicePixels="True"
                                    ClipToBounds="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Dropdown Arrow Button -->
                                    <ToggleButton x:Name="PART_DropDownToggle" 
                                                  Grid.ColumnSpan="2"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False" ClickMode="Press" Background="Transparent" BorderThickness="0">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent">
                                                    <Path x:Name="Arrow" Data="M 0 0 L 5 5 L 10 0" 
                                                          Stroke="{StaticResource C.Gray400}" StrokeThickness="1.8" 
                                                          HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" 
                                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>

                                    <!-- Selection Display (Non-editable) -->
                                    <ContentPresenter x:Name="ContentSite"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      Margin="12,0,0,0"
                                                      VerticalAlignment="Center"
                                                      IsHitTestVisible="False"/>

                                    <!-- Editable Text Area (The Search Bar) -->
                                    <TextBox x:Name="PART_EditableTextBox"
                                             Margin="10,0,0,0"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{StaticResource C.Gray800}"
                                             FontSize="13"
                                             VerticalAlignment="Center"
                                             Visibility="Hidden"
                                             IsReadOnly="{TemplateBinding IsReadOnly}"
                                             Padding="0"/>
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#FFFFFF"
                                        BorderBrush="{StaticResource C.Gray200}"
                                        BorderThickness="1.5"
                                        CornerRadius="12"
                                        Margin="0,4,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.10" BlurRadius="20" ShadowDepth="4"/>
                                    </Border.Effect>
                                    <ScrollViewer Padding="6" SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite"          Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#86EFAC"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource C.Green600}"/>
                                <Setter TargetName="Root" Property="Background"  Value="{StaticResource C.Green50}"/>
                                <Setter TargetName="FocusShadow" Property="Background" Value="{StaticResource C.Green50}"/>
                                <Setter TargetName="FocusShadow" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding"    Value="12,9"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource C.Gray800}"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7" Margin="2,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource C.Green50}"/>
                                <Setter Property="Foreground" Value="{StaticResource C.Green700}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource C.Green100}"/>
                                <Setter Property="Foreground" Value="{StaticResource C.Green700}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillRadio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="ShadowLayer" CornerRadius="10" Background="Transparent" Opacity="0">
                                <Border.Effect>
                                    <DropShadowEffect Color="#22C55E" Opacity="0.18" BlurRadius="8" ShadowDepth="0"/>
                                </Border.Effect>
                            </Border>

                            <Border x:Name="Pill" Background="{StaticResource C.White}"
                                    BorderBrush="{StaticResource C.Gray200}" BorderThickness="1.5"
                                    CornerRadius="10" Padding="14,8">
                                <TextBlock x:Name="Lbl" Text="{TemplateBinding Content}"
                                           FontSize="13" FontWeight="Medium" Foreground="{StaticResource C.Gray600}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background"    Value="{StaticResource C.Green100}"/>
                                <Setter TargetName="Pill" Property="BorderBrush"   Value="{StaticResource C.Green500}"/>
                                <Setter TargetName="Lbl"  Property="Foreground"    Value="{StaticResource C.Green700}"/>
                                <Setter TargetName="Lbl"  Property="FontWeight"    Value="SemiBold"/>
                                <Setter TargetName="ShadowLayer" Property="Background" Value="{StaticResource C.Green100}"/>
                                <Setter TargetName="ShadowLayer" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="BorderBrush" Value="#86EFAC"/>
                                <Setter TargetName="Pill" Property="Background"  Value="{StaticResource C.Green50}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DatePickerTextBox" TargetType="DatePickerTextBox">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePickerTextBox">
                        <Border Background="Transparent" BorderThickness="0">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Background="Transparent" BorderThickness="0"
                                          Padding="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormDatePicker" TargetType="DatePicker">
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Foreground"      Value="{StaticResource C.Gray800}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Padding"         Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CalendarStyle">
                <Setter.Value>
                    <Style TargetType="Calendar"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Grid x:Name="PART_Root" Height="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <DatePickerTextBox x:Name="PART_TextBox"
                                               Grid.Column="0"
                                               Style="{StaticResource DatePickerTextBox}"
                                               Foreground="{StaticResource C.Gray800}"
                                               FontSize="13" Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Background="Transparent" BorderThickness="0"/>
                            <Button x:Name="PART_Button" Grid.Column="1"
                                    Focusable="False" Width="28" Height="28"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="IconBg" CornerRadius="7" Background="Transparent">
                                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="14" Foreground="{StaticResource C.Gray400}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="IconBg" Property="Background" Value="{StaticResource C.Green50}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Popup x:Name="PART_Popup" Grid.Column="0"
                                   AllowsTransparency="True" Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=PART_Root}"
                                   StaysOpen="False">
                                <Border Background="White"
                                        BorderBrush="{StaticResource C.Gray200}"
                                        BorderThickness="1.5" CornerRadius="12" Margin="0,4,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.10" BlurRadius="20" ShadowDepth="4"/>
                                    </Border.Effect>
                                    <Calendar x:Name="PART_Calendar" Style="{TemplateBinding CalendarStyle}"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid x:Name="Overlay" Background="#01000000" MouseLeftButtonDown="Overlay_Click">

        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="1024">
            <Border CornerRadius="20" Background="{StaticResource C.White}">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.20" BlurRadius="60" ShadowDepth="0"/>
                </Border.Effect>
            </Border>

            <Border x:Name="DialogRoot" CornerRadius="20" ClipToBounds="True" Background="{StaticResource C.White}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" MinHeight="100" CornerRadius="20,20,0,0" Padding="26,24" SnapsToDevicePixels="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#16A34A" Offset="0"/>
                                <GradientStop Color="#15803D" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid VerticalAlignment="Top">
                            <Ellipse Width="120" Height="90"
                                     HorizontalAlignment="Right" VerticalAlignment="Top"
                                     Margin="0,-40,-30,0" Opacity="0.08">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="White"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Width="70" Height="70"
                                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                     Margin="0,0,60,-20" Opacity="0.06">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="White"/>
                                </Ellipse.Fill>
                            </Ellipse>

                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="46" Height="46" CornerRadius="13"
                                            Background="#33FFFFFF" Margin="0,0,14,0">
                                        <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="20" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="TitleText" Text="Thêm Hồ Sơ Khám"
                                                   FontSize="18" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock x:Name="SubtitleText" Text="Điền thông tin khám bệnh"
                                                   FontSize="12" Foreground="#BBF7D0" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Width="32" Height="32" Cursor="Hand" Click="Close_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" CornerRadius="16" Background="#26FFFFFF">
                                                <TextBlock Text="✕" FontSize="10" FontWeight="Bold"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#4DFFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" Background="{StaticResource C.Gray50}" VerticalScrollBarVisibility="Hidden">
                        <Grid Margin="20,18,20,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Border Background="{StaticResource C.White}" CornerRadius="16">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="18" ShadowDepth="3"/>
                                    </Border.Effect>
                                </Border>

                                <Border Background="{StaticResource C.White}" CornerRadius="16" Padding="20"
                                        BorderBrush="{StaticResource C.Gray100}" BorderThickness="1">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                            <Border Width="4" Height="18" CornerRadius="3" Margin="0,0,10,0" Background="{StaticResource C.Green600}"/>
                                            <TextBlock Text="THÔNG TIN CHUNG" FontSize="11" FontWeight="Bold"
                                                       Foreground="{StaticResource C.Gray600}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <TextBlock Style="{StaticResource FormLabel}">Bệnh Nhân<Run Text=" *" Foreground="{StaticResource C.Red}"/></TextBlock>
                                        <ComboBox x:Name="PatientNameBox" Style="{StaticResource FormComboBox}"
                                                  Margin="0,0,0,16" IsEditable="True" IsTextSearchEnabled="False"
                                                  StaysOpenOnEdit="True"
                                                  SelectionChanged="SearchComboBox_SelectionChanged"
                                                  LostKeyboardFocus="SearchComboBox_LostKeyboardFocus"/>

                                        <TextBlock Style="{StaticResource FormLabel}">Bác Sĩ<Run Text=" *" Foreground="{StaticResource C.Red}"/></TextBlock>
                                        <ComboBox x:Name="DoctorNameBox" Style="{StaticResource FormComboBox}"
                                                  Margin="0,0,0,16" IsEditable="True" IsTextSearchEnabled="False"
                                                  StaysOpenOnEdit="True"
                                                  SelectionChanged="SearchComboBox_SelectionChanged"
                                                  LostKeyboardFocus="SearchComboBox_LostKeyboardFocus"/>

                                        <TextBlock Text="Ngày Khám" Style="{StaticResource FormLabel}"/>
                                        <Border x:Name="DateBorder" CornerRadius="10" BorderBrush="{StaticResource C.Gray200}"
                                                BorderThickness="1.5" Background="{StaticResource C.White}" Height="40" Margin="0,0,0,16">
                                            <DatePicker x:Name="VisitDatePicker" Style="{StaticResource FormDatePicker}"/>
                                        </Border>

                                        <StackPanel Margin="0,0,0,4">
                                            <TextBlock Text="Loại Khám" Style="{StaticResource FormLabel}"/>
                                            <WrapPanel Margin="0,0,0,8">
                                                <RadioButton x:Name="RbWalkIn" Content="Trực tiếp" GroupName="VisitType" Style="{StaticResource PillRadio}" IsChecked="True"/>
                                                <RadioButton x:Name="RbAppt" Content="Hẹn lịch" GroupName="VisitType" Style="{StaticResource PillRadio}"/>
                                                <RadioButton x:Name="RbEmerg" Content="Cấp cứu" GroupName="VisitType" Style="{StaticResource PillRadio}"/>
                                                <RadioButton x:Name="RbFollow" Content="Tái khám" GroupName="VisitType" Style="{StaticResource PillRadio}"/>
                                            </WrapPanel>

                                            <TextBlock Text="Trạng Thái" Style="{StaticResource FormLabel}"/>
                                            <WrapPanel>
                                                <RadioButton x:Name="RbWaiting" Content="Chờ khám" GroupName="Status" Style="{StaticResource PillRadio}" IsChecked="True"/>
                                                <RadioButton x:Name="RbProgress" Content="Đang khám" GroupName="Status" Style="{StaticResource PillRadio}"/>
                                                <RadioButton x:Name="RbComplete" Content="Đã khám" GroupName="Status" Style="{StaticResource PillRadio}"/>
                                            </WrapPanel>
                                        </StackPanel>

                                        <Border Height="1" Background="{StaticResource C.Gray100}" Margin="0,18,0,18"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <Border Width="4" Height="18" CornerRadius="3" Margin="0,0,10,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#EF4444" Offset="0"/>
                                                        <GradientStop Color="#F97316" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <TextBlock Text="SINH HIỆU" FontSize="11" FontWeight="Bold"
                                                       Foreground="{StaticResource C.Gray600}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="&#xE95E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource C.Red}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                    <TextBlock Text="Mạch" Style="{StaticResource FormLabel}" Margin="0"/>
                                                    <TextBlock Text=" (l/p)" Style="{StaticResource UnitLabel}" VerticalAlignment="Bottom" Margin="2,0,0,1"/>
                                                </StackPanel>
                                                <TextBox x:Name="PulseBox" Style="{StaticResource FormTextBox}" Height="40" Padding="12,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="&#xE9CE;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#F97316" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                    <TextBlock Text="Huyết Áp" Style="{StaticResource FormLabel}" Margin="0"/>
                                                </StackPanel>
                                                <TextBox x:Name="BPBox" Style="{StaticResource FormTextBox}" Height="40" Padding="12,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="&#xE9CA;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#3B82F6" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                    <TextBlock Text="Nhiệt Độ" Style="{StaticResource FormLabel}" Margin="0"/>
                                                </StackPanel>
                                                <TextBox x:Name="TempBox" Style="{StaticResource FormTextBox}" Height="40" Padding="12,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Grid.Column="2">
                                <Border Background="{StaticResource C.White}" CornerRadius="16">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="18" ShadowDepth="3"/>
                                    </Border.Effect>
                                </Border>

                                <Border Background="{StaticResource C.White}" CornerRadius="16" Padding="20"
                                        BorderBrush="{StaticResource C.Gray100}" BorderThickness="1">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                            <Border Width="4" Height="18" CornerRadius="3" Margin="0,0,10,0" Background="#3B82F6"/>
                                            <TextBlock Text="LÂM SÀNG" FontSize="11" FontWeight="Bold"
                                                       Foreground="{StaticResource C.Gray600}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <TextBlock Text="Triệu Chứng" Style="{StaticResource FormLabel}"/>
                                        <TextBox x:Name="SymptomsBox" Style="{StaticResource FormTextBox}"
                                                 Height="86" TextWrapping="Wrap" AcceptsReturn="True"
                                                 VerticalContentAlignment="Top" Padding="12,10" Margin="0,0,0,16"/>

                                        <TextBlock Text="Chẩn Đoán" Style="{StaticResource FormLabel}"/>
                                        <TextBox x:Name="DiagnosisBox" Style="{StaticResource FormTextBox}"
                                                 Height="86" TextWrapping="Wrap" AcceptsReturn="True"
                                                 VerticalContentAlignment="Top" Padding="12,10" Margin="0,0,0,20"/>

                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="Đơn Thuốc" Style="{StaticResource FormLabel}" Margin="0"/>
                                            <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                                                    Cursor="Hand" Click="AddMedicine_Click" Margin="0,0,0,2">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="+" FontSize="14" FontWeight="Bold" Foreground="#3B82F6" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Thêm Thuốc" FontSize="12" FontWeight="Bold" 
                                                                     Foreground="#3B82F6" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>

                                        <Border x:Name="MedicineInputArea" Background="{StaticResource C.Gray50}" 
                                                CornerRadius="12" Padding="14" Margin="0,0,0,16" BorderThickness="1" BorderBrush="{StaticResource C.Gray200}">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,10,0">
                                                        <TextBlock Text="Chọn Thuốc" Style="{StaticResource FormLabel}"/>
                                                        <ComboBox x:Name="MedicineCombo" Style="{StaticResource FormComboBox}"
                                                                  Margin="0,0,0,14" IsEditable="True" IsTextSearchEnabled="False"
                                                                  StaysOpenOnEdit="True"
                                                                  SelectionChanged="SearchComboBox_SelectionChanged"
                                                                  LostKeyboardFocus="SearchComboBox_LostKeyboardFocus"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="Số Lượng" Style="{StaticResource FormLabel}"/>
                                                        <TextBox x:Name="MedicineQty" Style="{StaticResource FormTextBox}" Height="40" Padding="12,0"/>
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel Margin="0,10,0,0">
                                                    <TextBlock Text="Cách dùng / Liều lượng" Style="{StaticResource FormLabel}"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox x:Name="MedicineDosage" Style="{StaticResource FormTextBox}" Height="38" Padding="12,0"/>
                                                        <Button Grid.Column="1" Width="80" Height="38" Margin="10,0,0,0" 
                                                                Click="ConfirmAddMedicine_Click" Cursor="Hand">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Bg" CornerRadius="10" Background="{StaticResource C.Green600}">
                                                                        <TextBlock Text="Thêm" FontSize="12" FontWeight="Bold" 
                                                                                 Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource C.Green500}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <ListView x:Name="PrescriptionList" Margin="0,0,0,10" BorderThickness="0" Background="Transparent" d:ItemsSource="{d:SampleData ItemCount=1}">
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListViewItem">
                                                                <Border Background="{StaticResource C.White}" BorderBrush="{StaticResource C.Gray100}" 
                                                                        BorderThickness="0,0,0,1" Padding="0,10">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding Medicine.MedicineName}" FontWeight="SemiBold" Foreground="{StaticResource C.Gray800}"/>
                                                                            <TextBlock Text="{Binding Dosage}" FontSize="12" Foreground="{StaticResource C.Gray400}" Margin="0,2,0,0"/>
                                                                        </StackPanel>
                                                                        <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat='x {0}'}" 
                                                                                 FontWeight="SemiBold" Foreground="{StaticResource C.Gray600}" VerticalAlignment="Center" Margin="10,0,14,0"/>
                                                                        <Button Grid.Column="2" Width="28" Height="28" Background="Transparent" BorderThickness="0" 
                                                                                Cursor="Hand" Click="RemoveMedicine_Click" Tag="{Binding}">
                                                                            <TextBlock Text="✕" FontSize="10" Foreground="{StaticResource C.Red}"/>
                                                                        </Button>
                                                                    </Grid>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                        </ListView>

                                        <TextBlock Text="Ghi Chú Đơn Thuốc" Style="{StaticResource FormLabel}"/>
                                        <TextBox x:Name="PrescriptionBox" Style="{StaticResource FormTextBox}"
                                                 Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                                                 VerticalContentAlignment="Top" Padding="12,10" Margin="0,0,0,16"/>

                                        <TextBlock Text="Ghi Chú" Style="{StaticResource FormLabel}"/>
                                        <TextBox x:Name="NoteBox" Style="{StaticResource FormTextBox}"
                                                 Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                                                 VerticalContentAlignment="Top" Padding="12,10"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                        </Grid>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="{StaticResource C.White}"
                            BorderBrush="{StaticResource C.Gray100}" BorderThickness="0,1,0,0"
                            CornerRadius="0,0,20,20" Padding="26,16">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource C.Red}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock FontSize="12" Foreground="{StaticResource C.Gray400}" Text="Trường bắt buộc" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button Width="100" Height="40" Margin="0,0,12,0" Cursor="Hand" Click="Cancel_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" CornerRadius="10" Background="{StaticResource C.White}"
                                                    BorderBrush="{StaticResource C.Gray200}" BorderThickness="1.5">
                                                <TextBlock Text="Hủy" FontSize="13" FontWeight="Bold"
                                                           Foreground="{StaticResource C.Gray600}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource C.Gray50}"/>
                                                    <Setter TargetName="Bg" Property="BorderBrush" Value="#D1D5DB"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button x:Name="SaveBtn" Height="40" Padding="24,0" Cursor="Hand" Click="Save_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid x:Name="RootGrid">
                                                <Border CornerRadius="10" Background="{StaticResource C.Green600}">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#16A34A" Opacity="0.3" BlurRadius="12" ShadowDepth="2" Direction="270"/>
                                                    </Border.Effect>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,0">
                                                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="14" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        <TextBlock Text="Lưu Hồ Sơ" FontSize="13" FontWeight="Bold"
                                                                   Foreground="White" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RootGrid" Property="Opacity" Value="0.9"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="RootGrid" Property="Opacity" Value="0.8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>