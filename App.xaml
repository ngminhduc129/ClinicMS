<Application x:Class="ClinicMS.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ClinicMS.Converters"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Application.Resources>
        <ResourceDictionary>
            <!-- 1. MERGED DICTIONARIES (Must be first in XAML structure) -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Resources/Themes/ClinicTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 2. CORE FALLBACK RESOURCES (Direct children override merged dictionaries) -->
            <SolidColorBrush x:Key="TextBrushPrimary" Color="#111827"/>
            <SolidColorBrush x:Key="TextBrushSecondary" Color="#6B7280"/>
            <SolidColorBrush x:Key="TextBrushTertiary" Color="#9CA3AF"/>
            <SolidColorBrush x:Key="TextBrushWhite" Color="#FFFFFF"/>
            <sys:Double x:Key="FontScale">1.0</sys:Double>
            <sys:Double x:Key="FontSizePageTitle">30</sys:Double>
            <sys:Double x:Key="FontSizeSectionTitle">22</sys:Double>
            <sys:Double x:Key="FontSizeSubsectionTitle">19</sys:Double>
            <sys:Double x:Key="FontSizeCardTitle">17</sys:Double>
            <sys:Double x:Key="FontSizeBody">15</sys:Double>
            <sys:Double x:Key="FontSizeSmall">14</sys:Double>
            <sys:Double x:Key="FontSizeXSmall">13</sys:Double>
            <sys:Double x:Key="FontSizeButton">15</sys:Double>
            <sys:Double x:Key="FontSizeLabel">14</sys:Double>
            <sys:Double x:Key="FontSizeHelper">13</sys:Double>

            <!-- 3. CONVERTERS -->
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
            <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
            <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibility"/>
            <conv:StatusToBrushConverter x:Key="StatusToBrush"/>
            <conv:StatusToBackgroundConverter x:Key="StatusToBackground"/>
            <conv:ToastTypeToBrushConverter x:Key="ToastTypeToBrush"/>
            <conv:ToastTypeToForegroundConverter x:Key="ToastTypeToForeground"/>
            <conv:ZeroToVisibilityConverter x:Key="ZeroToVisibility"/>
            <conv:PageToBoldConverter x:Key="PageToBold"/>
            <conv:IndexConverter x:Key="IndexConverter"/>
            <conv:PercentageToHeightConverter x:Key="PercentageToHeightConverter"/>
            <conv:FontSizeConverter x:Key="FontSizeConverter"/>

            <!-- 4. GLOBAL ELEMENT STYLES -->
            
            <!-- BASE WINDOW STYLE -->
            <Style TargetType="Window">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="{Binding FontScale, Converter={StaticResource FontSizeConverter}, ConverterParameter=15, FallbackValue=15}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrushPrimary}"/>
                <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
                <Setter Property="UseLayoutRounding" Value="True"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <!-- GLOBAL TEXTBLOCK STYLE -->
            <Style TargetType="TextBlock">
                <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrushPrimary}"/>
                <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- 5. SHARED COMPONENT STYLES -->
            <Style x:Key="GreenButton" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                <Setter Property="FontSize" Value="{DynamicResource FontSizeButton}"/>
                <Setter Property="Foreground" Value="White"/>
            </Style>

            <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="FontSize" Value="{DynamicResource FontSizeButton}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrushPrimary}"/>
            </Style>

            <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource DangerButtonStyle}">
                <Setter Property="FontSize" Value="{DynamicResource FontSizeButton}"/>
                <Setter Property="Foreground" Value="White"/>
            </Style>

            <!-- FORM STYLES -->
            <Style x:Key="FormLabel" TargetType="TextBlock" BasedOn="{StaticResource FormLabelStyle}">
                <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrushPrimary}"/>
            </Style>

            <Style x:Key="FormTextBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBoxStyle}">
                <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrushPrimary}"/>
            </Style>

            <Style x:Key="FormComboBox" TargetType="ComboBox" BasedOn="{StaticResource ModernComboBoxStyle}">
                <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrushPrimary}"/>
            </Style>

            <Style x:Key="ClinicDataGrid" TargetType="DataGrid" BasedOn="{StaticResource ModernDataGridStyle}">
                <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrushPrimary}"/>
            </Style>
            
        </ResourceDictionary>
    </Application.Resources>
</Application>
