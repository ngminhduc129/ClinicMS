<UserControl x:Class="ClinicMS.Views.MedicineListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Self"
             Background="#F0FDF4"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <!-- Fix selection color to Green -->
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"                      Color="#DCFCE7"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"                  Color="#111827"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"     Color="#DCFCE7"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#111827"/>

        <!-- Icon Button Style -->
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Width"  Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="10" Background="White"
                                BorderBrush="#D1FAE5" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06" Color="#000"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"  Value="#F0FDF4"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#6EE7B7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Outline Button Style -->
        <Style x:Key="OutlineBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="10" Background="White"
                                BorderBrush="#D1FAE5" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06" Color="#000"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"  Value="#F0FDF4"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#6EE7B7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Green Button Style -->
        <Style x:Key="GreenBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="10" Background="#16A34A">
                            <Border.Effect>
                                <DropShadowEffect Color="#16A34A" BlurRadius="14" ShadowDepth="2" Opacity="0.35" Direction="270"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#15803D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,28,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title -->
            <RowDefinition Height="Auto"/> <!-- Toolbar & Stats -->
            <RowDefinition Height="Auto"/> <!-- Quick Filters -->
            <RowDefinition Height="*"/>    <!-- Table -->
        </Grid.RowDefinitions>

        <!-- ══════════════════ TITLE ══════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="12" Background="#DCFCE7" Margin="0,0,14,0">
                        <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#16A34A"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Kho Thuốc" FontSize="36" FontWeight="Bold" Foreground="#111827"/>
                        <TextBlock Text="Quản lý danh mục, giá và tồn kho thuốc y tế" FontSize="14" Foreground="#6B7280" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Stats Badge -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border CornerRadius="10" Background="White" BorderBrush="#D1FAE5" BorderThickness="1" Padding="16,8" Margin="0,0,12,0">
                    <Border.Effect><DropShadowEffect BlurRadius="10" Opacity="0.06" ShadowDepth="1"/></Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Giá trị kho:" FontSize="13" Foreground="#6B7280" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtTotalValue" Text="0 ₫" FontSize="13" FontWeight="Bold" Foreground="#16A34A"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="10" Background="White" BorderBrush="#D1FAE5" BorderThickness="1" Padding="16,8">
                    <Border.Effect><DropShadowEffect BlurRadius="10" Opacity="0.06" ShadowDepth="1"/></Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Sắp hết:" FontSize="13" Foreground="#6B7280" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtLowStockCount" Text="0" FontSize="13" FontWeight="Bold" Foreground="#EF4444"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ══════════════════ TOOLBAR ══════════════════ -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Search Box -->
            <Border Grid.Column="0" Width="320" Height="40" Background="White" CornerRadius="10" BorderBrush="#D1FAE5" BorderThickness="1">
                <Border.Effect><DropShadowEffect BlurRadius="10" Opacity="0.06" ShadowDepth="1"/></Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#9CA3AF" Margin="13,0,8,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtSearch" Grid.Column="1" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="13" Padding="0,0,12,0" TextChanged="Search_TextChanged"/>
                    <TextBlock IsHitTestVisible="False" Text="Tìm tên thuốc hoặc đơn vị..." VerticalAlignment="Center" Grid.Column="1" Foreground="#9CA3AF" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Style="{StaticResource IconBtn}" Margin="0,0,10,0" ToolTip="Làm mới" Click="Refresh_Click">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#16A34A"/>
                </Button>
                <Button Style="{StaticResource GreenBtn}" Click="Add_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="20" Height="20" CornerRadius="10" Background="#15803D" Margin="0,0,8,0">
                            <TextBlock Text="+" FontSize="15" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                        </Border>
                        <TextBlock Text="Thêm Thuốc" FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ══════════════════ QUICK FILTERS ══════════════════ -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,20">
            <RadioButton Content="Tất cả" IsChecked="True" Style="{StaticResource {x:Type ToggleButton}}" 
                         Padding="16,6" Margin="0,0,8,0" BorderThickness="0" Click="FilterAll_Click"/>
            <RadioButton Content="Sắp hết hàng" Style="{StaticResource {x:Type ToggleButton}}" 
                         Padding="16,6" Margin="0,0,8,0" BorderThickness="0" Click="FilterLowStock_Click"/>
            <RadioButton Content="Đã hết hàng" Style="{StaticResource {x:Type ToggleButton}}" 
                         Padding="16,6" Margin="0,0,8,0" BorderThickness="0" Click="FilterOutOfStock_Click"/>
        </StackPanel>

        <!-- ══════════════════ DATA TABLE ══════════════════ -->
        <Border Grid.Row="3" Background="White" CornerRadius="10">
            <Border.Effect><DropShadowEffect BlurRadius="20" Opacity="0.08" ShadowDepth="0"/></Border.Effect>
            <Border x:Name="TableCard" Background="White" CornerRadius="10" MinHeight="400">
                <DataGrid ItemsSource="{Binding Medicines}"
                          Visibility="{Binding LoadingMedicines, Converter={StaticResource InverseBoolToVisibility}}"
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          IsReadOnly="True" GridLinesVisibility="None" BorderThickness="0"
                          Background="Transparent" RowHeight="54" AlternationCount="999999"
                          VerticalScrollBarVisibility="Auto">
                    
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F9FAFB"/>
                            <Setter Property="Foreground" Value="#9CA3AF"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="16,14"/>
                            <Setter Property="BorderBrush" Value="#F3F4F6"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="BorderBrush" Value="#F3F4F6"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F0FDF4"/><Setter Property="BorderBrush" Value="#D1FAE5"/></Trigger>
                                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#DCFCE7"/><Setter Property="BorderBrush" Value="#A7F3D0"/></Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="Transparent"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>
                        <!-- STT -->
                        <DataGridTemplateColumn Header="STT" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock FontWeight="Medium" Foreground="#9CA3AF" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource IndexConverter}">
                                                <Binding /><Binding Path="ItemsSource" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- TÊN THUỐC -->
                        <DataGridTemplateColumn Header="TÊN THUỐC" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="16,0">
                                        <Border Width="32" Height="32" Background="#F0FDF4" CornerRadius="8">
                                            <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" Foreground="#16A34A" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                                        </Border>
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MedicineName}" FontWeight="SemiBold" Foreground="#111827" FontSize="13"/>
                                            <TextBlock Text="{Binding Unit, StringFormat='Đơn vị: \{0\}'}" Foreground="#6B7280" FontSize="11" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- ĐƠN GIÁ -->
                        <DataGridTextColumn Header="ĐƠN GIÁ" Width="130" Binding="{Binding PriceDisplay, Mode=OneWay}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="Padding" Value="16,0"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#111827"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- TỒN KHO -->
                        <DataGridTemplateColumn Header="TỒN KHO" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="16,0">
                                        <Grid>
                                            <TextBlock Text="{Binding StockQuantity}" FontWeight="Bold" Foreground="#111827" FontSize="13"/>
                                            <TextBlock Text="{Binding StockStatus}" HorizontalAlignment="Right" Foreground="{Binding StockStatusColor, FallbackValue=#16A34A}" FontSize="11" FontWeight="Bold"/>
                                        </Grid>
                                        <ProgressBar Value="{Binding StockPercent, Mode=OneWay}" Height="3" Margin="0,4,0,0" BorderThickness="0" Background="#F3F4F6" Foreground="{Binding StockStatusColor, FallbackValue=#16A34A}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- THÀNH TIỀN -->
                        <DataGridTextColumn Header="THÀNH TIỀN" Width="140" Binding="{Binding StockValueDisplay, Mode=OneWay}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="Padding" Value="16,0"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#16A34A"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- ACTIONS -->
                        <DataGridTemplateColumn Header="" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,12,0">
                                        <Button Width="32" Height="32" Margin="0,0,4,0" Cursor="Hand" ToolTip="Sửa" Click="Edit_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bg" CornerRadius="8" Background="Transparent"><TextBlock x:Name="Ic" Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#9CA3AF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#DCFCE7"/><Setter TargetName="Ic" Property="Foreground" Value="#16A34A"/></Trigger></ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Width="32" Height="32" Cursor="Hand" ToolTip="Xóa" Click="Delete_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bg" CornerRadius="8" Background="Transparent"><TextBlock x:Name="Ic" Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#9CA3AF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#FEE2E2"/><Setter TargetName="Ic" Property="Foreground" Value="#B91C1C"/></Trigger></ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Border>
    </Grid>
</UserControl>
