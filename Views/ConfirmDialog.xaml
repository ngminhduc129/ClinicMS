<UserControl x:Class="ClinicMS.Views.ConfirmDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="400">
    <UserControl.Resources></UserControl.Resources>
    <Border CornerRadius="10" Background="White">
        <Border.Effect>
            <DropShadowEffect Color="#000" Opacity="0.2" BlurRadius="24" ShadowDepth="0"/>
        </Border.Effect>
        <StackPanel Margin="28,24">
            <TextBlock x:Name="TitleTb" FontSize="18" FontWeight="Bold"
                       Foreground="#111827" Margin="0,0,0,12"/>
            <TextBlock x:Name="MessageTb" FontSize="14" Foreground="#4B5563"
                       TextWrapping="Wrap" Margin="0,0,0,24"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource OutlineButton}" Content="Không" Width="80" Margin="0,0,12,0" Click="No_Click"/>
                <Button Style="{StaticResource DangerButton}" Content="Có, Xóa" Width="90" Click="Yes_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>


