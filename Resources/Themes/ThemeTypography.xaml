<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--=========================================-->
    <!-- FONT FAMILIES -->
    <!--=========================================-->
    <FontFamily x:Key="FontFamilyPrimary">Segoe UI, Arial, sans-serif</FontFamily>
    <FontFamily x:Key="FontFamilyMonospace">Courier New, Consolas</FontFamily>

    <!--=========================================-->
    <!-- FONT SIZES (in pixels) -->
    <!--=========================================-->
    <!-- Headings -->
    <sys:Double x:Key="FontSizePageTitle">30</sys:Double>
    <sys:Double x:Key="FontSizeSectionTitle">22</sys:Double>
    <sys:Double x:Key="FontSizeSubsectionTitle">19</sys:Double>
    <sys:Double x:Key="FontSizeCardTitle">17</sys:Double>
    
    <!-- Body text -->
    <sys:Double x:Key="FontSizeBody">15</sys:Double>
    <sys:Double x:Key="FontSizeSmall">14</sys:Double>
    <sys:Double x:Key="FontSizeXSmall">13</sys:Double>
    
    <!-- Button text -->
    <sys:Double x:Key="FontSizeButton">15</sys:Double>
    
    <!-- Label text -->
    <sys:Double x:Key="FontSizeLabel">14</sys:Double>
    
    <!-- Helper text -->
    <sys:Double x:Key="FontSizeHelper">13</sys:Double>

    <!--=========================================-->
    <!-- FONT WEIGHTS -->
    <!--=========================================-->
    <FontWeight x:Key="FontWeightLight">Light</FontWeight>
    <FontWeight x:Key="FontWeightRegular">Normal</FontWeight>
    <FontWeight x:Key="FontWeightMedium">SemiBold</FontWeight>
    <FontWeight x:Key="FontWeightBold">Bold</FontWeight>
    <FontWeight x:Key="FontWeightExtraBold">ExtraBlack</FontWeight>

    <!--=========================================-->
    <!-- PARAGRAPH/LINE HEIGHTS -->
    <!--=========================================-->
    <sys:Double x:Key="LineHeightTight">1.2</sys:Double>
    <sys:Double x:Key="LineHeightNormal">1.5</sys:Double>
    <sys:Double x:Key="LineHeightRelaxed">1.8</sys:Double>

    <!--=========================================-->
    <!-- TITLE / HEADING STYLES -->
    <!--=========================================-->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyPrimary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizePageTitle}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightBold}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrushPrimary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyPrimary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeSectionTitle}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightBold}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrushPrimary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="SubsectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyPrimary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeSubsectionTitle}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightMedium}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrushPrimary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="CardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyPrimary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeCardTitle}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightBold}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrushPrimary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!--=========================================-->
    <!-- BODY TEXT STYLES -->
    <!--=========================================-->
    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyPrimary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightRegular}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrushPrimary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="{StaticResource LineHeightNormal}"/>
    </Style>

    <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyPrimary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightRegular}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrushSecondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="SmallTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyPrimary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightRegular}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrushSecondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="XSmallTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyPrimary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeXSmall}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightRegular}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrushTertiary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!--=========================================-->
    <!-- LABEL STYLES -->
    <!--=========================================-->
    <Style x:Key="FormLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyPrimary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeLabel}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightMedium}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrushPrimary}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="HelperTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyPrimary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeHelper}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightRegular}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrushSecondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <!--=========================================-->
    <!-- EMPHASIS STYLES -->
    <!--=========================================-->
    <Style x:Key="EmphasisBoldStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyPrimary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightBold}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrushPrimary}"/>
    </Style>

    <Style x:Key="EmphasisColorStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyPrimary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightMedium}"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryGreenBrush}"/>
    </Style>

</ResourceDictionary>
