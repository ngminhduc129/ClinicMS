<UserControl x:Class="ClinicMS.Views.MessageDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="400">
    
    <Border Background="White" CornerRadius="16" BorderBrush="#F3F4F6" BorderThickness="1">
        <Border.Effect><StaticResource ResourceKey="ElevatedShadow"/></Border.Effect>
        
        <StackPanel Margin="24">
            <!-- Icon -->
            <Border Width="56" Height="56" CornerRadius="28" Margin="0,8,0,16" x:Name="IconBg">
                <TextBlock x:Name="IconTxt" FontFamily="Segoe MDL2 Assets" FontSize="24" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            
            <!-- Title & Message -->
            <TextBlock x:Name="TitleTxt" FontSize="18" FontWeight="Bold" Foreground="#111827" 
                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock x:Name="MessageTxt" FontSize="14" Foreground="#6B7280" 
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" LineHeight="20"/>
            
            <!-- Action Button -->
            <Button x:Name="OkBtn" Click="Ok_Click" Margin="0,24,0,0" Height="42" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#16A34A" CornerRadius="10">
                            <TextBlock Text="Đã hiểu" Foreground="White" FontWeight="SemiBold" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#15803D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
