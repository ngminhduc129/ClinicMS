<UserControl x:Class="ClinicMS.Views.PatientDetailDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ClinicMS.Views"
             Width="580"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources></UserControl.Resources>
    <Grid>
        <!-- Global Shadow layer -->
        <Border Background="White" CornerRadius="10">
            <Border.Effect><DropShadowEffect Color="#000" Opacity="0.15" BlurRadius="32" ShadowDepth="0"/></Border.Effect>
        </Border>

        <Border x:Name="DialogRoot" CornerRadius="10" ClipToBounds="True" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Padding="24,18,18,18" CornerRadius="10,10,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#16A34A" Offset="0"/>
                            <GradientStop Color="#15803D" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="52" Height="52" CornerRadius="10" Margin="0,0,14,0">
                                <Border.Background><SolidColorBrush Color="#FFFFFF" Opacity="0.2"/></Border.Background>
                                <TextBlock x:Name="InitialsCircle" FontSize="20" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="NameText" FontSize="20" FontWeight="Bold" Foreground="White"/>
                                <TextBlock x:Name="GenderDobText" FontSize="13" Foreground="#BBF7D0" Margin="0,3,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Background="#FFFFFF26" Foreground="White"
                                    BorderThickness="0" Padding="14,7" FontSize="13" FontWeight="Medium"
                                    Cursor="Hand" Margin="0,0,8,0" Click="Edit_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" CornerRadius="10" Padding="{TemplateBinding Padding}"
                                                Background="{TemplateBinding Background}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Sửa" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background">
                                                    <Setter.Value><SolidColorBrush Color="#FFFFFF" Opacity="0.25"/></Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Content="✕" Background="#FFFFFF26" Foreground="White"
                                    BorderThickness="0" Width="34" Height="34" FontSize="14"
                                    Cursor="Hand" Click="Close_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" CornerRadius="10" Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background">
                                                    <Setter.Value><SolidColorBrush Color="#FFFFFF" Opacity="0.25"/></Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Body -->
                <ScrollViewer Grid.Row="1" Background="#F8FAF9" VerticalScrollBarVisibility="Hidden" Padding="22,18">
                    <StackPanel>
                        <!-- Liên hệ -->
                        <StackPanel Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="&#xE717;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#16A34A" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="THÔNG TIN LIÊN HỆ" FontSize="10.5" FontWeight="Bold"
                                           Foreground="#6B7280" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Grid>
                                <!-- Shadow layer -->
                                <Border Background="White" CornerRadius="10">
                                    <Border.Effect><DropShadowEffect Color="#000" Opacity="0.05" BlurRadius="10" ShadowDepth="1"/></Border.Effect>
                                </Border>
                                <!-- Content layer -->
                                <Border Background="White" CornerRadius="10" Padding="18">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <local:InfoRow Grid.Column="0" Label="Điện Thoại" x:Name="PhoneRow"/>
                                        <local:InfoRow Grid.Column="1" Label="Email"      x:Name="EmailRow"/>
                                        <local:InfoRow Grid.Column="2" Label="Địa Chỉ"   x:Name="AddressRow"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- Sức khỏe -->
                        <StackPanel Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="&#xEA37;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#EF4444" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="CHỈ SỐ SỨC KHỎE" FontSize="10.5" FontWeight="Bold"
                                           Foreground="#6B7280" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Grid>
                                <!-- Shadow layer -->
                                <Border Background="White" CornerRadius="10">
                                    <Border.Effect><DropShadowEffect Color="#000" Opacity="0.05" BlurRadius="10" ShadowDepth="1"/></Border.Effect>
                                </Border>
                                <!-- Content layer -->
                                <Border Background="White" CornerRadius="10" Padding="18">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <local:InfoRow Grid.Column="0" Label="Nhóm Máu"  x:Name="BloodRow"/>
                                        <local:InfoRow Grid.Column="1" Label="Chiều Cao" x:Name="HeightRow"/>
                                        <local:InfoRow Grid.Column="2" Label="Cân Nặng"  x:Name="WeightRow"/>
                                        <local:InfoRow Grid.Column="3" Label="Ghi Chú"   x:Name="NoteRow"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- Lịch sử khám -->
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#16A34A" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="LỊCH SỬ KHÁM BỆNH" FontSize="10.5" FontWeight="Bold"
                                           Foreground="#6B7280" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Grid>
                                <!-- Shadow layer -->
                                <Border Background="White" CornerRadius="10">
                                    <Border.Effect><DropShadowEffect Color="#000" Opacity="0.05" BlurRadius="10" ShadowDepth="1"/></Border.Effect>
                                </Border>
                                <!-- Content layer -->
                                <Border Background="White" CornerRadius="10" MinHeight="80">
                                    <StackPanel>
                                        <TextBlock x:Name="NoVisitsText" Text="Chưa có hồ sơ khám nào"
                                                   FontSize="13" Foreground="#9CA3AF"
                                                   HorizontalAlignment="Center" Margin="0,24,0,24"
                                                   Visibility="Collapsed"/>
                                        <ItemsControl x:Name="VisitList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="16,12">
                                                        <Grid>
                                                            <StackPanel>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Border Background="#F0FDF4" CornerRadius="10"
                                                                            Padding="6,3" Margin="0,0,8,0">
                                                                        <TextBlock Text="{Binding VisitTime}" FontSize="11"
                                                                                   FontWeight="Bold" Foreground="#16A34A"/>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding VisitTypeDisplay}" FontSize="13"
                                                                               FontWeight="Medium" Foreground="#1F2937"
                                                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                    <Border CornerRadius="10" Padding="8,2"
                                                                            Background="{Binding Status, Converter={StaticResource StatusToBackground}}">
                                                                        <TextBlock Text="{Binding StatusDisplay}" FontSize="11"
                                                                                   Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Diagnosis}" FontSize="12"
                                                                           Foreground="#6B7280" Margin="0,5,0,0"
                                                                           TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                       FontSize="12" Foreground="#374151"
                                                                       Text="{Binding DoctorName}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>


