<UserControl x:Class="ClinicMS.Views.DoctorDetailDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ClinicMS.Views"
             Width="540" Height="500"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    
    <Grid>
        <!-- MODERN DIALOG CONTAINER -->
        <Border x:Name="DialogRoot" Style="{StaticResource DialogContainerStyle}" 
                Background="Transparent" BorderThickness="0" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- HEADER WITH GRADIENT -->
                <Border Grid.Row="0" Padding="28,24" CornerRadius="18,18,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#16A34A" Offset="0"/>
                            <GradientStop Color="#15803D" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <!-- Avatar Circle -->
                            <Border Width="64" Height="64" CornerRadius="18" Margin="0,0,18,0">
                                <Border.Background>
                                    <SolidColorBrush Color="White" Opacity="0.15"/>
                                </Border.Background>
                                <TextBlock x:Name="InitialsText" FontSize="24" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="NameText" FontSize="22" FontWeight="Bold" Foreground="White"/>
                                <TextBlock x:Name="SpecialtyText" FontSize="14" Foreground="#BBF7D0" Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Header Actions -->
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{StaticResource IconButtonStyle}" Click="Edit_Click" ToolTip="Chỉnh sửa thông tin">
                                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" Opacity="0.9"/>
                            </Button>
                            <Button Style="{StaticResource IconButtonStyle}" Click="Close_Click" Margin="8,0,0,0">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" Opacity="0.9"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CONTENT BODY -->
                <Border Grid.Row="1" Background="#F9FAFB" CornerRadius="0,0,18,18">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="28,24">
                            <!-- INFO SECTION -->
                            <StackPanel Margin="0,0,0,24">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Width="3" Height="16" Background="#16A34A" CornerRadius="2" Margin="0,0,10,0"/>
                                    <TextBlock Text="THÔNG TIN CƠ BẢN" Style="{StaticResource XSmallTextStyle}" FontWeight="Bold" Foreground="#16A34A"/>
                                </StackPanel>

                                <Border Style="{StaticResource CardContainerStyle}" Padding="20">
                                    <UniformGrid Columns="2">
                                        <local:InfoRow Label="Mã Bác Sĩ"     x:Name="IdRow"/>
                                        <local:InfoRow Label="Số điện thoại" x:Name="PhoneRow"/>
                                        <local:InfoRow Label="Email"          x:Name="EmailRow"/>
                                        <local:InfoRow Label="Chuyên khoa"    x:Name="SpecRow"/>
                                    </UniformGrid>
                                </Border>
                            </StackPanel>

                            <!-- BIO / NOTES SECTION -->
                            <StackPanel x:Name="NoteSection">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Width="3" Height="16" Background="#3B82F6" CornerRadius="2" Margin="0,0,10,0"/>
                                    <TextBlock Text="GIỚI THIỆU &amp; GHI CHÚ" Style="{StaticResource XSmallTextStyle}" FontWeight="Bold" Foreground="#3B82F6"/>
                                </StackPanel>

                                <Border Style="{StaticResource CardContainerStyle}" Padding="20" MinHeight="100">
                                    <TextBlock x:Name="NoteText" FontSize="14" Foreground="#374151"
                                               LineHeight="22" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
