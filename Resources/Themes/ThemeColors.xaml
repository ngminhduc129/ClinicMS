<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!--=========================================-->
    <!-- PRIMARY BRAND COLORS - Medical Green -->
    <!--=========================================-->
    <Color x:Key="PrimaryGreenColor">#16A34A</Color>
    <Color x:Key="PrimaryGreenDarkColor">#166534</Color>
    <Color x:Key="PrimaryGreenLightColor">#DCFCE7</Color>
    <Color x:Key="PrimaryGreenVeryLightColor">#F0FDF4</Color>
    
    <!--=========================================-->
    <!-- BACKGROUND COLORS -->
    <!--=========================================-->
    <Color x:Key="BackgroundColorLight">#F9FAFB</Color>
    <Color x:Key="BackgroundColorDark">#F3F4F6</Color>
    <Color x:Key="SurfaceColorWhite">#FFFFFF</Color>
    
    <!--=========================================-->
    <!-- BORDER & DIVIDER COLORS -->
    <!--=========================================-->
    <Color x:Key="BorderColorLight">#E5E7EB</Color>
    <Color x:Key="BorderColorMedium">#D1D5DB</Color>
    <Color x:Key="DividerColor">#E5E7EB</Color>
    
    <!--=========================================-->
    <!-- TEXT COLORS -->
    <!--=========================================-->
    <Color x:Key="TextPrimaryColor">#111827</Color>
    <Color x:Key="TextSecondaryColor">#6B7280</Color>
    <Color x:Key="TextTertiaryColor">#9CA3AF</Color>
    <Color x:Key="TextWhiteColor">#FFFFFF</Color>
    
    <!--=========================================-->
    <!-- STATUS COLORS -->
    <!--=========================================-->
    <Color x:Key="SuccessColorGreen">#10B981</Color>
    <Color x:Key="WarningColorAmber">#F59E0B</Color>
    <Color x:Key="ErrorColorRed">#EF4444</Color>
    <Color x:Key="InfoColorBlue">#3B82F6</Color>
    
    <!-- Light variants for backgrounds -->
    <Color x:Key="SuccessColorLightBg">#ECFDF5</Color>
    <Color x:Key="WarningColorLightBg">#FFFBEB</Color>
    <Color x:Key="ErrorColorLightBg">#FEF2F2</Color>
    <Color x:Key="InfoColorLightBg">#EFF6FF</Color>
    
    <!--=========================================-->
    <!-- HOVER & INTERACTION COLORS -->
    <!--=========================================-->
    <Color x:Key="HoverBackgroundColor">#F3F4F6</Color>
    <Color x:Key="PressedBackgroundColor">#E5E7EB</Color>
    <Color x:Key="DisabledBackgroundColor">#F3F4F6</Color>
    <Color x:Key="DisabledTextColor">#9CA3AF</Color>
    <Color x:Key="FocusHighlightColor">#16A34A</Color>
    
    <!--=========================================-->
    <!-- SHADOW & OVERLAY COLORS -->
    <!--=========================================-->
    <Color x:Key="ShadowColorDark">#000000</Color>
    <Color x:Key="OverlayColorDimmed">#000000</Color>
    
    <!--=========================================-->
    <!-- SOLID COLOR BRUSHES (for direct use in XAML) -->
    <!--=========================================-->
    
    <!-- Primary Brand Brushes -->
    <SolidColorBrush x:Key="PrimaryGreenBrush" Color="{StaticResource PrimaryGreenColor}"/>
    <SolidColorBrush x:Key="PrimaryGreenDarkBrush" Color="{StaticResource PrimaryGreenDarkColor}"/>
    <SolidColorBrush x:Key="PrimaryGreenLightBrush" Color="{StaticResource PrimaryGreenLightColor}"/>
    <SolidColorBrush x:Key="PrimaryGreenVeryLightBrush" Color="{StaticResource PrimaryGreenVeryLightColor}"/>
    
    <!-- Background Brushes -->
    <SolidColorBrush x:Key="BackgroundBrushLight" Color="{StaticResource BackgroundColorLight}"/>
    <SolidColorBrush x:Key="BackgroundBrushDark" Color="{StaticResource BackgroundColorDark}"/>
    <SolidColorBrush x:Key="SurfaceBrushWhite" Color="{StaticResource SurfaceColorWhite}"/>
    
    <!-- Border Brushes -->
    <SolidColorBrush x:Key="BorderBrushLight" Color="{StaticResource BorderColorLight}"/>
    <SolidColorBrush x:Key="BorderBrushMedium" Color="{StaticResource BorderColorMedium}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}"/>
    
    <!-- Text Brushes -->
    <SolidColorBrush x:Key="TextBrushPrimary" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextBrushSecondary" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextBrushTertiary" Color="{StaticResource TextTertiaryColor}"/>
    <SolidColorBrush x:Key="TextBrushWhite" Color="{StaticResource TextWhiteColor}"/>
    
    <!-- Status Brushes -->
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColorGreen}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColorAmber}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColorRed}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColorBlue}"/>
    
    <!-- Light Status Backgrounds -->
    <SolidColorBrush x:Key="SuccessBkgBrush" Color="{StaticResource SuccessColorLightBg}"/>
    <SolidColorBrush x:Key="WarningBkgBrush" Color="{StaticResource WarningColorLightBg}"/>
    <SolidColorBrush x:Key="ErrorBkgBrush" Color="{StaticResource ErrorColorLightBg}"/>
    <SolidColorBrush x:Key="InfoBkgBrush" Color="{StaticResource InfoColorLightBg}"/>
    
    <!-- Interaction Brushes -->
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="{StaticResource HoverBackgroundColor}"/>
    <SolidColorBrush x:Key="PressedBackgroundBrush" Color="{StaticResource PressedBackgroundColor}"/>
    <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="{StaticResource DisabledBackgroundColor}"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledTextColor}"/>
    <SolidColorBrush x:Key="FocusHighlightBrush" Color="{StaticResource FocusHighlightColor}"/>
    
    <!-- Shadow & Overlay -->
    <SolidColorBrush x:Key="ShadowBrush" Color="{StaticResource ShadowColorDark}" Opacity="0.15"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="{StaticResource OverlayColorDimmed}" Opacity="0.5"/>
    
    <!--=========================================-->
    <!-- MODERN SHADOW EFFECTS (nested in ThemeControls) -->
    <!--=========================================-->
    <!-- Soft subtle shadow for cards -->
    <DropShadowEffect x:Key="SoftShadow" x:Shared="False"
                      Color="#000000" BlurRadius="12" ShadowDepth="1" Opacity="0.08" Direction="270"/>

    <!-- Medium shadow for elevated elements -->
    <DropShadowEffect x:Key="StandardShadow" x:Shared="False"
                      Color="#000000" BlurRadius="16" ShadowDepth="2" Opacity="0.12" Direction="270"/>

    <!-- Stronger shadow for modals and overlays -->
    <DropShadowEffect x:Key="ElevatedShadow" x:Shared="False"
                      Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.16" Direction="270"/>

    <!-- Very subtle shadow for inputs -->
    <DropShadowEffect x:Key="InsetShadow" x:Shared="False"
                      Color="#000000" BlurRadius="8" ShadowDepth="1" Opacity="0.06" Direction="270"/>
    
</ResourceDictionary>
