<UserControl x:Class="ClinicMS.Views.ConfirmDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="400" x:Name="Self">
    <Border Background="White" CornerRadius="20" BorderBrush="#F3F4F6" BorderThickness="1">
        <Border.Effect><StaticResource ResourceKey="ElevatedShadow"/></Border.Effect>
        <StackPanel Margin="28">
             <!-- Icon -->
            <Border Width="60" Height="60" CornerRadius="30" Margin="0,4,0,20" Background="#FEF2F2">
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="26" 
                           Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- Title & Message -->
            <TextBlock x:Name="TitleTb" FontSize="20" FontWeight="Bold" Foreground="#111827" 
                       HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock x:Name="MessageTb" FontSize="14" Foreground="#6B7280" 
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" LineHeight="22"/>

            <!-- Action Buttons -->
            <Grid Margin="0,32,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button Click="No_Click" Height="44" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="#F3F4F6" CornerRadius="12">
                                <TextBlock Text="Hủy bỏ" Foreground="#4B5563" FontWeight="SemiBold" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#E5E7EB"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Grid.Column="2" Click="Yes_Click" Height="44" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="#EF4444" CornerRadius="12">
                                <TextBlock Text="Xác nhận" Foreground="White" FontWeight="SemiBold" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#DC2626"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
